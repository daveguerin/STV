","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"type":"topic","kind":"symbol","role":"symbol","title":"SCSelectionSection"},"doc://ie.dgapps.STV/documentation/STV/SCObjectSection/initWithHeaderTitle:boundObject:boundObjectDefinition:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithHeaderTitle:boundObject:boundObjectDefinition:"}],"role":"symbol","abstract":[{"type":"text","text":"Returns an initialized "},{"code":"SCObjectSection","type":"codeVoice"},{"type":"text","text":" given a header title, a bound object and its extended class definition."}],"title":"initWithHeaderTitle:boundObject:boundObjectDefinition:","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scobjectsection\/initwithheadertitle:boundobject:boundobjectdefinition:","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection\/initWithHeaderTitle:boundObject:boundObjectDefinition:"},"doc://ie.dgapps.STV/documentation/STV/SCObjectSection/configureCell:forPropertyDefinition:inEditingMode:":{"abstract":[{"type":"text","text":"Configures the cell for the given property definition."}],"kind":"symbol","title":"configureCell:forPropertyDefinition:inEditingMode:","url":"\/documentation\/stv\/scobjectsection\/configurecell:forpropertydefinition:ineditingmode:","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"configureCell:forPropertyDefinition:inEditingMode:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection\/configureCell:forPropertyDefinition:inEditingMode:","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection":{"kind":"symbol","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of any kind of objects and automatically generate its cells from these objects. In addition,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" generates its detail views from the properties of the corresponding"},{"type":"text","text":" "},{"type":"text","text":"object in its items array. Objects in the items array need not all be of the same object type, but"},{"type":"text","text":" "},{"type":"text","text":"they must all decend from N