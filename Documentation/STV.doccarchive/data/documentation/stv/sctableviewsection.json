ection\/footerheight-c.ivar"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/setAttributesTo:":{"kind":"symbol","url":"\/documentation\/stv\/sctableviewsection\/setattributesto:","title":"setAttributesTo:","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"setAttributesTo:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewSection\/setAttributesTo:","type":"topic","abstract":[{"text":"Method should be overridden by subclasses to support property attributes.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCSelectionSection","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","type":"topic","title":"SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"text":"This class functions as an SCTableViewModel section that is able to provide selection functionality.","type":"text"},{"text":" ","type":"text"},{"text":"The cells in this section represent different items that the end-user can select from, and they","type":"text"},{"text":" ","type":"text"},{"text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next","type":"text"},{"text":" ","type":"text"},{"text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their","type":"text"},{"text":" ","type":"text"},{"text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all.","type":"text"}]}}}