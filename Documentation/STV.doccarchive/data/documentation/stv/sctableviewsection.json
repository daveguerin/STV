ble to automatically generate"},{"type":"text","text":" "},{"text":"its cells from a given bound object’s properties. If the bound object is given without an extended","type":"text"},{"text":" ","type":"text"},{"text":"class definition (SCClassDefinition), then cells will only be generated for properties of type","type":"text"},{"text":" ","type":"text"},{"text":"NSString and NSNumber, and will be either of type SCTextFieldCell or SCNumericTextFieldCell,","type":"text"},{"text":" ","type":"text"},{"text":"respectively. If an SCClassDefinition is provided for the bound object, a full fledged","type":"text"},{"type":"text","text":" "},{"type":"text","text":"section of cells will be generated."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection","role":"symbol","kind":"symbol","title":"SCObjectSection","url":"\/documentation\/stv\/scobjectsection"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/indexForCell:":{"fragments":[{"text":"- ","kind":"text"},{"text":"indexForCell:","kind":"identifier"}],"abstract":[{"text":"Returns the index of the specified cell.","type":"text"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewSection\/indexForCell:","role":"symbol","kind":"symbol","title":"indexForCell:","url":"\/documentation\/stv\/sctableviewsection\/indexforcell:"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/sectionActions-c.ivar":{"kind":"symbol","url":"\/documentation\/stv\/sctableviewsection\/sectionactions-c.ivar","title":"sectionActions","role":"symbol","fragments":[{"text":"sectionActions","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewSection\/sectionActions-c.ivar","type":"topic","abstract":[{"text":"The set of section action blocks.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/rollbackToInitialCellValues":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"rollbackToInitialC