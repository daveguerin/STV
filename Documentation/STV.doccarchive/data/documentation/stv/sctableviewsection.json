{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/cellAtIndex:":{"role":"symbol","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"cellAtIndex:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewSection\/cellAtIndex:","type":"topic","title":"cellAtIndex:","url":"\/documentation\/stv\/sctableviewsection\/cellatindex:","abstract":[{"type":"text","text":"Returns the cell at the specified index."}]},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/boundObject-c.property":{"role":"symbol","kind":"symbol","fragments":[{"text":"boundObject","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewSection\/boundObject-c.property","type":"topic","title":"boundObject","url":"\/documentation\/stv\/sctableviewsection\/boundobject-c.property","abstract":[{"text":"Provides subclasses with the framework to bind an SCTableViewSection to an NSObject","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection/headerHeight-c.property":{"fragments":[{"text":"headerHeight","kind":"identifier"}],"abstract":[{"type":"te