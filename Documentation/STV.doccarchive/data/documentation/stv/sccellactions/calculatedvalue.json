 Objective-C","cellActions.calculatedValue = ^NSObject*(SCTableViewCell *cell, NSIndexPath *indexPath)","{","    NSNumber *speed = [cell.boundObject valueForKey:@\"speed\"];","    NSNumber *distance = [cell.boundObject valueForKey:@\"distance\"];","    CGFloat time = 0;","    if([speed floatValue])","        time = [distance floatValue]\/[speed floatValue];","","    return [NSNumber numberWithFloat:time];","};"]}]}],"variants":[{"paths":["\/documentation\/stv\/sccellactions\/calculatedvalue"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Action is used to provide a value for calculated cells.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCCellCalculatedValueAction_Block":{"fragments":[{"text":"SCCellCalculatedValueAction_Block","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellCalculatedValueAction_Block","kind":"symbol","url":"\/documentation\/stv\/sccellcalculatedvalueaction_block","role":"symbol","abstract":[{"type":"text","text":"A block that calculates a value for a table-view cell."}],"title":"SCCellCalculatedValueAction_Block"},"doc://ie.dgapps.STV/documentation/STV/SCCellActions/calculatedValue":{"fragments":[{"kind":"identifier","text":"calculatedValue"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/calculatedValue","url":"\/documentation\/stv\/sccellactions\/calculatedvalue","type":"topic","abstract":[{"text":"Action is used to provide a value for calculated cells.","type":"text"}],"kind":"symbol","role":"symbol","title":"calculatedValue"},"doc://ie.dgapps.STV/documentation/STV/SCCellActions":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\