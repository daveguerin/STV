{"metadata":{"fragments":[{"kind":"identifier","text":"detailTableViewModel"}],"roleHeading":"Instance Property","navigatorTitle":[{"kind":"identifier","text":"detailTableViewModel"}],"symbolKind":"property","externalID":"c:objc(cs)SCCellActions(py)detailTableViewModel","modules":[{"name":"STV"}],"role":"symbol","title":"detailTableViewModel"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"copy"},{"kind":"text","text":") "},{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellDetailTableViewModelAction_Block","preciseIdentifier":"c:SCCellActions.h@T@SCCellDetailTableViewModelAction_Block","kind":"typeIdentifier","text":"SCCellDetailTableViewModelAction_Block"},{"kind":"text","text":" "},{"kind":"identifier","text":"detailTableViewModel"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This action is typically used to provide your own custom detail model, instead of the one automatically generated by the cell. This might be needed in cases where the cell generates a detail SCArrayOfObjectsSection for example, and you need an SCArrayOfObjectsModel instead (to automatically generate sections for instance).","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"It is much more common to use the detailViewController action instead, assigning the custom model in the custom view controller’s viewDidLoad method. This also gives you the chance to add a search bar (for example, to make use of SCArrayOfObjectsModel automatic searching functionality), or any other controls."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"The block returns the custom detail model. It must not already be associated with a table view because the framework handles that association. Returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ignores the action.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example:"}],"type":"paragraph"},{"syntax":"objective-c","code":["\/\/ Objective-C","cellActions.detailTableViewModel = ^SCTableViewModel*(SCTableViewCell *cell, NSIndexPath *indexPath)","{","    SCTableViewModel *detailModel = nil;","    if([cell isKindOfClass:[SCArrayOfObjectsCell class]])","    {","        detailModel = [SCArrayOfObjectsModel modelWithTableView:nil];","    }","","    return detailModel;","};"],"type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This action is only applicable to cells that generate detail views, such as SCSelectionCell and SCArrayOfObjectsCell."}]}],"type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/detailTableViewModel","interfaceLanguage":"occ"},"sections":[],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions"]]},"abstract":[{"type":"text","text":"Action gets called to give you the chance to return a custom detail model for the cell’s detail view controller."}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/sccellactions\/detailtableviewmodel"]}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCCellActions/detailTableViewModel":{"kind":"symbol","abstract":[{"text":"Action gets called to give you the chance to return a custom detail model for the cell’s detail view controller.","type":"text"}],"title":"detailTableViewModel","url":"\/documentation\/stv\/sccellactions\/detailtableviewmodel","role":"symbol","fragments":[{"kind":"identifier","text":"detailTableViewModel"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/detailTableViewModel","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCCellActions":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions","title":"SCCellActions","kind":"symbol","url":"\/documentation\/stv\/sccellactions","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"SCCellActions"}],"abstract":[{"type":"text","text":"This class hosts a set of cell action blocks. Once an action is set to a desired code block, it will execute the block as soon as the action occurs."}]},"doc://ie.dgapps.STV/documentation/STV/SCCellDetailTableViewModelAction_Block":{"fragments":[{"text":"SCCellDetailTableViewModelAction_Block","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A block that supplies the detail table-view model for a table-view cell."}],"type":"topic","title":"SCCellDetailTableViewModelAction_Block","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellDetailTableViewModelAction_Block","url":"\/documentation\/stv\/sccelldetailtableviewmodelaction_block","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"}}}