{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/editActions"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"property","title":"editActions","fragments":[{"text":"editActions","kind":"identifier"}],"externalID":"c:objc(cs)SCCellActions(py)editActions","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"editActions"}],"modules":[{"name":"STV"}],"roleHeading":"Instance Property"},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"copy","kind":"keyword"},{"text":") ","kind":"text"},{"text":"SCCellEditActionsAction_Block","kind":"typeIdentifier","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellEditActionsAction_Block","preciseIdentifier":"c:SCCellActions.h@T@SCCellEditActionsAction_Block"},{"text":" ","kind":"text"},{"text":"editActions","kind":"identifier"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this action when you want to provide custom edit actions for your cell. When the user swipes horizontally, the table view moves the cell content aside to reveal your actions. Tapping one of the action buttons executes the handler block stored with the action object."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The block returns an array of "},{"type":"codeVoice","code":"UITableViewRowAction"},{"text":" objects representing the actions for the cell. Each action creates a button that the user can tap.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"code":["\/\/ Objective-C","cellActions.editActions = ^NSArray*(SCTableViewCell *cell, NSIndexPath *indexPath)","{","    UITableViewRowAction *customButton = [UITableViewRowAction rowActionWithStyle:UITableViewRowActionStyleDefault title:@\"Button\" handler:^(UITableViewRowAction *action, NSIndexPath *indexPath)","    {","        NSLog(@\"Custom edit action button tapped!\");","","        [cell.ownerTableViewModel.tableView setEditing:NO]; \/\/ collapse the cell back after completing custom edit action","    }];","    customButton.backgroundColor = [UIColor greenColor]; \/\/arbitrary color","","    UITableViewRowAction *deleteButton = [UITableViewRowAction rowActionWithStyle:UITableViewRowActionStyleDefault title:@\"Delete\" handler:^(UITableViewRowAction *action, NSIndexPath *indexPath)","    {","        if([cell.ownerSection isKindOfClass:[SCArrayOfItemsSection class]])","            [(SCArrayOfItemsSection *)cell.ownerSection dispatchEventRemoveRowAtIndexPath:indexPath];  \/\/ delete the cell","    }];","    deleteButton.backgroundColor = [UIColor redColor];","","    return @[deleteButton, customButton];","};"],"type":"codeListing","syntax":"objective-c"}]}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions"]]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/sccellactions\/editactions"]}],"sections":[],"abstract":[{"text":"Action gets called to provide custom edit action buttons that appear when the user swipes the cell horizontally.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCCellActions/editActions":{"kind":"symbol","abstract":[{"type":"text","text":"Action gets called to provide custom edit action buttons that appear when the user swipes the cell horizontally."}],"title":"editActions","url":"\/documentation\/stv\/sccellactions\/editactions","role":"symbol","fragments":[{"kind":"identifier","text":"editActions"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/editActions","type":"topic"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCCellActions":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions","title":"SCCellActions","kind":"symbol","url":"\/documentation\/stv\/sccellactions","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"SCCellActions"}],"abstract":[{"type":"text","text":"This class hosts a set of cell action blocks. Once an action is set to a desired code block, it will execute the block as soon as the action occurs."}]},"doc://ie.dgapps.STV/documentation/STV/SCCellEditActionsAction_Block":{"fragments":[{"text":"SCCellEditActionsAction_Block","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A block that supplies the contextual editing actions for a table-view cell."}],"title":"SCCellEditActionsAction_Block","type":"topic","url":"\/documentation\/stv\/sccelleditactionsaction_block","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellEditActionsAction_Block","kind":"symbol"}}}