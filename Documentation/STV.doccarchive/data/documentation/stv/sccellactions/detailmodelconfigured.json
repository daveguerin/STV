{"kind":"symbol","variants":[{"paths":["\/documentation\/stv\/sccellactions\/detailmodelconfigured"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/detailModelConfigured"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"text":" (","kind":"text"},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"copy"},{"kind":"text","text":") "},{"kind":"typeIdentifier","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCDetailModelCellAction_Block","text":"SCDetailModelCellAction_Block","preciseIdentifier":"c:SCCellActions.h@T@SCDetailModelCellAction_Block"},{"kind":"text","text":" "},{"text":"detailModelConfigured","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This action is typically used to add additional custom sections, or modify the already existing automatically generated ones.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example:","type":"text"}]},{"syntax":"objective-c","code":["\/\/ Objective-C","cellActions.detailModelConfigured = ^(SCTableViewCell *cell, NSIndexPath *indexPath, SCTableViewModel *detailModel)","{","    SCTableViewSection *customSection = [SCTableViewSection section];","    SCCustomCell *customCell = [SCCustomCell cellWithText:@\"Custom Cell\"];","    [customSection addCell:customCell];","","    [detailModel addSection:customSection];","};"],"type":"codeListing"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"In general, it is easier (and more recommended) to add your custom sections and cells using the data definitions, instead of using this action to do so. For more information, please refer to SCDataDefinition and SCCustomPropertyDefinition."}],"type":"paragraph"}],"name":"Note"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"This action is only applicable to cells that generate detail views, such as SCSelectionCell.","type":"text"}],"type":"paragraph"}],"name":"Note"}]}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Action gets called after the cell’s detail model is fully configured, including the addition of all automatically generated sections."}],"sections":[],"metadata":{"role":"symbol","navigatorTitle":[{"text":"detailModelConfigured","kind":"identifier"}],"fragments":[{"text":"detailModelConfigured","kind":"identifier"}],"roleHeading":"Instance Property","modules":[{"name":"STV"}],"symbolKind":"property","externalID":"c:objc(cs)SCCellActions(py)detailModelConfigured","title":"detailModelConfigured"},"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","title":"STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCCellActions/detailModelConfigured":{"type":"topic","abstract":[{"text":"Action gets called after the cell’s detail model is fully configured, including the addition of all automatically generated sections.","type":"text"}],"fragments":[{"text":"detailModelConfigured","kind":"identifier"}],"role":"symbol","title":"detailModelConfigured","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions\/detailModelConfigured","url":"\/documentation\/stv\/sccellactions\/detailmodelconfigured","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV/SCCellActions":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellActions","title":"SCCellActions","kind":"symbol","url":"\/documentation\/stv\/sccellactions","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"SCCellActions"}],"abstract":[{"type":"text","text":"This class hosts a set of cell action blocks. Once an action is set to a desired code block, it will execute the block as soon as the action occurs."}]},"doc://ie.dgapps.STV/documentation/STV/SCDetailModelCellAction_Block":{"fragments":[{"kind":"identifier","text":"SCDetailModelCellAction_Block"}],"kind":"symbol","url":"\/documentation\/stv\/scdetailmodelcellaction_block","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCDetailModelCellAction_Block","title":"SCDetailModelCellAction_Block","abstract":[{"type":"text","text":"A block invoked with a table-view cell and its detail model."}],"type":"topic","role":"symbol"}}}