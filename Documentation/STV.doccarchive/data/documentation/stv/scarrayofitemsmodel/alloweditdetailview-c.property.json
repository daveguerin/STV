{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Allows\/disables a detail view for editing items’ values. Default: TRUE."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"readwrite","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:@T@BOOL","text":"BOOL","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"allowEditDetailView","kind":"identifier"},{"text":";","kind":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Detail views are automatically generated for editing new items. You can control wether the","type":"text"},{"text":" ","type":"text"},{"text":"view appears as a modal view or gets pushed to the navigation stack using the detailViewModal","type":"text"},{"text":" ","type":"text"},{"text":"property. Modal views have the added feature of giving the end user a Cancel and Done buttons.","type":"text"},{"text":" ","type":"text"},{"text":"The Cancel button cancels all user’s actions, while the Done button commits them. Also, if the","type":"text"},{"text":" ","type":"text"},{"text":"cell’s validation is enabled, the Done button will remain disabled until all cells’ values","type":"text"},{"text":" ","type":"text"},{"text":"are valid.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel"]]},"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel\/allowEditDetailView-c.property","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/stv\/scarrayofitemsmodel\/alloweditdetailview-c.property"],"traits":[{"interfaceLang