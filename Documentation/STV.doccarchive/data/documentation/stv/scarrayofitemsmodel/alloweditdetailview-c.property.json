{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel"]]},"metadata":{"fragments":[{"kind":"identifier","text":"allowEditDetailView"}],"navigatorTitle":[{"text":"allowEditDetailView","kind":"identifier"}],"role":"symbol","title":"allowEditDetailView","symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"STV"}],"externalID":"c:objc(cs)SCArrayOfItemsModel(py)allowEditDetailView"},"abstract":[{"text":"Allows\/disables a detail view for editing items’ values. Default: TRUE.","type":"text"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel\/allowEditDetailView-c.property"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"readwrite"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowEditDetailView"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Detail views are automatically generated for editing new items. You can control wether the"},{"type":"text","text":" "},{"type":"text","text":"view appears as a modal view or gets pushed to the navigation stack using the detailViewModal"},{"type":"text","text":" "},{"type":"text","text":"property. Modal views have the added feature of giving the end user a Cancel and Done buttons."},{"type":"text","text":" "},{"type":"text","text":"The Cancel button cancels all user’s actions, while the Done button commits them. Also, if the"},{"type":"text","text":" "},{"type":"text","text":"cell’s validation is enabled, the Done button will remain disabled until all cells’ values"},{"type":"text","text":" "},{"type":"text","text":"are valid."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/stv\/scarrayofitemsmodel\/alloweditdetailview-c.property"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsModel":{"role":"symbol","fragments":[{"text":"SCArrayOfItemsModel","kind":"identifier"}],"url":"\/documentation\/stv\/scarrayofitemsmodel","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel","kind":"symbol","type":"topic","abstract":[{"text":"This class subclasses SCTableViewModel to represent an array of any kind of items and will automatically generate its cells from these items. ","type":"text"},{"code":"SCArrayOfItemsModel","type":"codeVoice"},{"text":" will automatically generate a set of SCArrayOfItemsSection(s) if the sectionHeaderTitleForItem modelAction is implemented, otherwise it will only generate a single SCArrayOfItemsSection.","type":"text"}],"title":"SCArrayOfItemsModel"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsModel/allowEditDetailView-c.property":{"fragments":[{"text":"allowEditDetailView","kind":"identifier"}],"type":"topic","abstract":[{"text":"Allows\/disables a detail view for editing items’ values. Default: TRUE.","type":"text"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel\/allowEditDetailView-c.property","role":"symbol","kind":"symbol","title":"allowEditDetailView","url":"\/documentation\/stv\/scarrayofitemsmodel\/alloweditdetailview-c.propert