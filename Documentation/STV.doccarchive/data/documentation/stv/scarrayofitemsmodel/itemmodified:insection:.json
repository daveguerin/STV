}],"name":"item"},{"name":"section","content":[{"type":"paragraph","inlineContent":[{"text":"The section used to configure the model.","type":"text"}]}]}],"kind":"parameters"}],"kind":"symbol","references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsModel":{"role":"symbol","fragments":[{"text":"SCArrayOfItemsModel","kind":"identifier"}],"url":"\/documentation\/stv\/scarrayofitemsmodel","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel","kind":"symbol","type":"topic","abstract":[{"text":"This class subclasses SCTableViewModel to represent an array of any kind of items and will automatically generate its cells from these items. ","type":"text"},{"code":"SCArrayOfItemsModel","type":"codeVoice"},{"text":" will automatically generate a set of SCArrayOfItemsSection(s) if the sectionHeaderTitleForItem modelAction is implemented, otherwise it will only generate a single SCArrayOfItemsSection.","type":"text"}],"title":"SCArrayOfItemsModel"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsModel/itemModified:inSection:":{"fragments":[{"text":"- ","kind":"text"},{"text":"itemModified:inSection:","kind":"identifier"}],"type":"topic","abstract":[{"text":"Method called internally by framework when a model item has been modified.","type":"text"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel\/itemModified:inSection:","role":"symbol","kind":"symbol","title":"itemModified:inSection:","url":"\/documentation\/stv\/scarrayofitemsmodel\/itemmodified:insection:"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"}}}