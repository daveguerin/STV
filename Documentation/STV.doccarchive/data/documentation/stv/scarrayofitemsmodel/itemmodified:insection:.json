fitemsmodel\/itemmodified:insection:"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"Method called internally by framework when a model item has been modified."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsModel/itemModified:inSection:":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel\/itemModified:inSection:","title":"itemModified:inSection:","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"itemModified:inSection:","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Method called internally by framework when a model item has been modified."}],"url":"\/documentation\/stv\/scarrayofitemsmodel\/itemmodified:insection:"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsModel":{"title":"SCArrayOfItemsModel","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsModel","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemsmodel","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"SCArrayOfItemsModel"}],"abstract":[{"text":"This class subclasses SCTableViewModel to represent an array of any kind of items and will automatically generate its cells from these items. ","type":"text"},{"code":"SCArrayOfItemsModel","type":"codeVoice"},{"text":" will automatically generate a set of SCArrayOfItemsSection(s) if the sectionHeaderTitleForItem modelAction is implemented, otherwise it will only generate a single SCArrayOfItemsSection.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"}}}