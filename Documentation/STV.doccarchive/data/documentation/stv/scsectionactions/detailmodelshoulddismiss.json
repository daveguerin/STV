{"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions\/detailModelShouldDismiss"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"property","title":"detailModelShouldDismiss","fragments":[{"kind":"identifier","text":"detailModelShouldDismiss"}],"role":"symbol","externalID":"c:objc(cs)SCSectionActions(py)detailModelShouldDismiss","navigatorTitle":[{"text":"detailModelShouldDismiss","kind":"identifier"}],"roleHeading":"Instance Property","modules":[{"name":"STV"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"copy","kind":"keyword"},{"text":") ","kind":"text"},{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCConditionalDetailModelSectionAction_Block","text":"SCConditionalDetailModelSectionAction_Block","preciseIdentifier":"c:SCSectionActions.h@T@SCConditionalDetailModelSectionAction_Block","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"detailModelShouldDismiss","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Example:","type":"text"}],"type":"paragraph"},{"syntax":"objective-c","code":["\/\/ Objective-C","sectionActions.detailModelShouldDismiss = ^BOOL(SCTableViewSection *section, SCTableViewModel *detailModel, NSIndexPath *indexPath)","{","    return YES;  \/\/ allow detail model to be dismissed","};"],"type":"codeListing"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"This action is only applicable to sections that generate detail views, such as SCArrayOfObjectsSection."}],"type":"paragraph"}],"type":"aside"},{"name":"Warning","style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the case where the detail model is not associated with an existing row (such as the case when "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" creates a new item), indexPath.row will be set to NSNotFound. This is a good way to test if the detail model was generated for a new item or an already existing one."}]}],"type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions"]]},"variants":[{"paths":["\/documentation\/stv\/scsectionactions\/detailmodelshoulddismiss"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"abstract":[{"type":"text","text":"Action gets called to give you a chance to decide if the detail model should be dismissed. Return YES to allow the detail model to be dismissed, otherwise return NO."}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCConditionalDetailModelSectionAction_Block":{"fragments":[{"text":"SCConditionalDetailModelSectionAction_Block","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCConditionalDetailModelSectionAction_Block","kind":"symbol","url":"\/documentation\/stv\/scconditionaldetailmodelsectionaction_block","role":"symbol","abstract":[{"type":"text","text":"A block that returns a Boolean decision for a section’s detail model."}],"title":"SCConditionalDetailModelSectionAction_Block"},"doc://ie.dgapps.STV/documentation/STV/SCSectionActions/detailModelShouldDismiss":{"fragments":[{"text":"detailModelShouldDismiss","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions\/detailModelShouldDismiss","url":"\/documentation\/stv\/scsectionactions\/detailmodelshoulddismiss","type":"topic","abstract":[{"text":"Action gets called to give you a chance to decide if the detail model should be dismissed. Return YES to allow the detail model to be dismissed, otherwise return NO.","type":"text"}],"kind":"symbol","role":"symbol","title":"detailModelShouldDismiss"},"doc://ie.dgapps.STV/documentation/STV/SCSectionActions":{"role":"symbol","type":"topic","fragments":[{"text":"SCSectionActions","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions","abstract":[{"type":"text","text":"This class hosts a set of section action blocks. Once an action is set to a desired code block, it will execute the block as soon as the action occurs."}],"kind":"symbol","url":"\/documentation\/stv\/scsectionactions","title":"SCSectionActions"}}}