{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions"]]},"metadata":{"roleHeading":"Instance Property","fragments":[{"text":"cellForRowAtIndexPath","kind":"identifier"}],"title":"cellForRowAtIndexPath","externalID":"c:objc(cs)SCSectionActions(py)cellForRowAtIndexPath","symbolKind":"property","navigatorTitle":[{"kind":"identifier","text":"cellForRowAtIndexPath"}],"modules":[{"name":"STV"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"copy","kind":"keyword"},{"text":") ","kind":"text"},{"text":"SCCellForRowAtIndexPathAction_Block","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellForRowAtIndexPathAction_Block","preciseIdentifier":"c:SCSectionActions.h@T@SCCellForRowAtIndexPathAction_Block","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"cellForRowAtIndexPath","kind":"identifier"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The block returns an ","type":"text"},{"type":"reference","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCustomCell","isActive":true},{"text":" instance or subclass. Returning ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ignores the action.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Example:","type":"text"}]},{"syntax":"objective-c","type":"codeListing","code":["\/\/ Objective-C","sectionActions.cellForRowAtIndexPath = ^SCCustomCell*(SCArrayOfItemsSection *itemsSection, NSIndexPath *indexPath)","{","    \/\/ `1` and `2` are the tags of the labels corresponding to","    \/\/ the firstName and lastName object properties  ( NO NEED to provide bindingsString if your cell uses curly brace binding )","    NSString *bindingsString = @\"1:firstName;2:lastName\";","","    SCCustomCell *customCell = [SCCustomCell cellWithText:nil objectBindingsString:bindingsString nibName:@\"MyCustomCell\"];","","    return customCell;","};"]},{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"If more than one type of custom cell is returned (e.g.: depending on the indexPath), then you ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"must"}]},{"text":" also use the reuseIdentifierForRowAtIndexPath action to return a unique reuse id for each different cell you return. Otherwise, there is no need to set the reuseIdentifierForRowAtIndexPath action.","type":"text"}]}],"type":"aside"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This action is only applicable to sections that generate detail views, such as SCArrayOfObjectsSection.","type":"text"}]}],"type":"aside"},{"style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"reference","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions\/reuseIdentifierForRowAtIndexPath","isActive":true}]}],"type":"aside"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scsectionactions\/cellforrowatindexpath"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions\/cellForRowAtIndexPath"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Action gets called to give you the chance to return a custom cell for the section’s item, instead of the automatically generated standard SCTableViewCell."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCCustomCell":{"title":"SCCustomCell","kind":"symbol","type":"topic","url":"\/documentation\/stv\/sccustomcell","role":"symbol","fragments":[{"text":"SCCustomCell","kind":"identifier"}],"abstract":[{"type":"text","text":"This class functions as a base class for all user defined custom cells."}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCustomCell"},"doc://ie.dgapps.STV/documentation/STV/SCSectionActions/cellForRowAtIndexPath":{"role":"symbol","kind":"symbol","fragments":[{"text":"cellForRowAtIndexPath","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions\/cellForRowAtIndexPath","url":"\/documentation\/stv\/scsectionactions\/cellforrowatindexpath","title":"cellForRowAtIndexPath","abstract":[{"type":"text","text":"Action gets called to give you the chance to return a custom cell for the section’s item, instead of the automatically generated standard SCTableViewCell."}]},"doc://ie.dgapps.STV/documentation/STV/SCCellForRowAtIndexPathAction_Block":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCCellForRowAtIndexPathAction_Block","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCCellForRowAtIndexPathAction_Block","url":"\/documentation\/stv\/sccellforrowatindexpathaction_block","title":"SCCellForRowAtIndexPathAction_Block","abstract":[{"type":"text","text":"A block that supplies the custom cell for a row."}]},"doc://ie.dgapps.STV/documentation/STV/SCSectionActions":{"fragments":[{"text":"SCSectionActions","kind":"identifier"}],"abstract":[{"type":"text","text":"This class hosts a set of section action blocks. Once an action is set to a desired code block, it will execute the block as soon as the action occurs."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSectionActions","role":"symbol","kind":"symbol","title":"SCSectionActions","url":"\/documentation\/stv\/scsectionactions"},"doc://ie.dgapps.STV/documentation/STV/SCSectionActions/reuseIdentifierForRowAtIndexPath":{"role":"symbol","kind":"symbol","fragments":[