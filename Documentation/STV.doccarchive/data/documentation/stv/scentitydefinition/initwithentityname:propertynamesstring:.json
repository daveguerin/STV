{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition"]]},"kind":"symbol","abstract":[{"text":"Returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"text","text":"- ("},{"kind":"keyword","text":"instancetype"},{"kind":"text","text":") "},{"kind":"identifier","text":"initWithEntityName:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"kind":"text","text":" *) "},{"text":"entityName","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"propertyNamesString:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"propertyNamesString","kind":"internalParam"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"name":"entityName","content":[{"type":"paragraph","inlineContent":[{"text":"The name of the entity for which the definition will be extended.","type":"text"}]}]},{"name":"propertyNamesString","content":[{"inlineContent":[{"text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The method will also generate user friendly property titles from the names of","type":"text"},{"text":" ","type":"text"},{"text":"the given properties. These titles can be modified by the user later as part of","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the property definition customization."}]},{"inlineContent":[{"type":"text","text":"Property names string syntax options:"},{"type":"text","text":" "},{"type":"text","text":"@“property1;property2;property3;…”"},{"type":"text","text":" "},{"type":"text","text":"@“group1 header:(property1, property2,…):group1 footer;group2…”"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Note: This method attempts to automatically determine the required NSManagedObjectContext by querying the current app delegate. If your app delegate does not provide an NSManagedObjectContext, or if you’d like to provide a diffrerent one, please use initWithEntityName:managedObjectContext:propertyNamesString: instead."}],"type":"paragraph"}],"type":"aside","name":"Warning","style":"warning"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Instance Method","title":"initWithEntityName:propertyNamesString:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithEntityName:propertyNamesString:","kind":"identifier"}],"modules":[{"name":"STV"}],"symbolKind":"method","role":"symbol","externalID":"c:objc(cs)SCEntityDefinition(im)initWithEntityName:propertyNamesString:","fragments":[{"text":"- ","kind":"text"},{"kind":"identifier","text":"initWithEntityName:propertyNamesString:"}]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/initWithEntityName:propertyNamesString:"},"variants":[{"paths":["\/documentation\/stv\/scentitydefinition\/initwithentityname:propertynamesstring:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition":{"type":"topic","fragments":[{"text":"SCEntityDefinition","kind":"identifier"}],"url":"\/documentation\/stv\/scentitydefinition","title":"SCEntityDefinition","role":"symbol","kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition","abstract":[{"type":"text","text":"This class functions as a means to further extend the definition of user-defined Core Data entities."},{"type":"text","text":" "},{"type":"text","text":"Using entity definitions, classes like SCObjectCell and SCObjectSection"},{"text":" ","type":"text"},{"type":"text","text":"will be able to better generate user interface elements that truly represent the"},{"type":"text","text":" "},{"type":"text","text":"properties of their bound objects."}]},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition/initWithEntityName:propertyNamesString:":{"abstract":[{"text":"Returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for.","type":"text"}],"url":"\/documentation\/stv\/scentitydefinition\/initwithentityname:propertynamesstring:","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/initWithEntityName:propertyNamesString:","title":"initWithEntityName:propertyNamesString:","fragments":[{"text":"- ","kind":"text"},{"text":"initWithEntityName:propertyNamesString:","kind":"identifier"}],"type":"topic","kind":"symbol"}}}