{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition"]]},"metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithEntityName:propertyNamesString:"}],"title":"initWithEntityName:propertyNamesString:","externalID":"c:objc(cs)SCEntityDefinition(im)initWithEntityName:propertyNamesString:","symbolKind":"method","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithEntityName:propertyNamesString:","kind":"identifier"}],"modules":[{"name":"STV"}],"role":"symbol"},"abstract":[{"type":"text","text":"Returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for."}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/initWithEntityName:propertyNamesString:"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"initWithEntityName:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"entityName","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"propertyNamesString:","kind":"identifier"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"kind":"text","text":" *) "},{"text":"propertyNamesString","kind":"internalParam"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The name of the entity for which the definition will be extended.","type":"text"}],"type":"paragraph"}],"name":"entityName"},{"content":[{"inlineContent":[{"text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”.","type":"text"}],"type":"paragraph"}],"name":"propertyNamesString"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The method will also generate user friendly property titles from the names of","type":"text"},{"text":" ","type":"text"},{"text":"the given properties. These titles can be modified by the user later as part of","type":"text"},{"text":" ","type":"text"},{"text":"the property definition customization.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Property names string syntax options:","type":"text"},{"text":" ","type":"text"},{"text":"@“property1;property2;property3;…”","type":"text"},{"text":" ","type":"text"},{"text":"@“group1 header:(property1, property2,…):group1 footer;group2…”","type":"text"}]},{"type":"aside","style":"warning","name":"Warning","content":[{"inlineContent":[{"text":"Note: This method attempts to automatically determine the required NSManagedObjectContext by querying the current app delegate. If your app delegate does not provide an NSManagedObjectContext, or if you’d like to provide a diffrerent one, please use initWithEntityName:managedObjectContext:propertyNamesString: instead.","type":"text"}],"type":"paragraph"}]}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/stv\/scentitydefinition\/initwithentityname:propertynamesstring:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract