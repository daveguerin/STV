"name":"entityName"},{"name":"context","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The managed object context of the entity."}]}]},{"name":"propertyNamesString","content":[{"type":"paragraph","inlineContent":[{"text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method will also generate user friendly property titles from the names of"},{"type":"text","text":" "},{"type":"text","text":"the given properties. These titles can be modified by the user later as part of"},{"type":"text","text":" "},{"type":"text","text":"the property definition customization."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Property names string syntax options:"},{"type":"text","text":" "},{"type":"text","text":"@“property1;property2;property3;…”"},{"type":"text","text":" "},{"type":"text","text":"@“group1 header:(property1, property2,…):group1 footer;group2…”"}]}],"kind":"content"}],"abstract":[{"text":"Allocates and returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for.","type":"text"}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scentitydefinition\/definitionwithentityname:managedobjectcontext:propertynamesstring:"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefiniti