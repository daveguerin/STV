{"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/definitionWithEntityName:propertyNamesString:","interfaceLanguage":"occ"},"metadata":{"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"definitionWithEntityName:propertyNamesString:"}],"externalID":"c:objc(cs)SCEntityDefinition(cm)definitionWithEntityName:propertyNamesString:","roleHeading":"Type Method","modules":[{"name":"STV"}],"navigatorTitle":[{"text":"+ ","kind":"text"},{"text":"definitionWithEntityName:propertyNamesString:","kind":"identifier"}],"role":"symbol","symbolKind":"method","title":"definitionWithEntityName:propertyNamesString:"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"text","text":"+ ("},{"kind":"keyword","text":"instancetype"},{"kind":"text","text":") "},{"kind":"identifier","text":"definitionWithEntityName:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"entityName"},{"kind":"text","text":" "},{"kind":"identifier","text":"propertyNamesString:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier","text":"NSString"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"propertyNamesString"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The name of the entity for which the definition will be extended.","type":"text"}],"type":"paragraph"}],"name":"entityName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”."}]}],"name":"propertyNamesString"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The method will also generate user friendly property titles from the names of"},{"type":"text","text":" "},{"type":"text","text":"the given properties. These titles can be modified by the user later as part of"},{"type":"text","text":" "},{"type":"text","text":"the property definition customization."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Property names string syntax options:"},{"type":"text","text":" "},{"type":"text","text":"@“property1;property2;property3;…”"},{"type":"text","text":" "},{"type":"text","text":"@“group1 header:(property1, property2,…):group1 footer;group2…”"}]},{"type":"aside","style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Note: This method attempts to automatically determine the required NSManagedObjectContext by querying the current app delegate. If your app delegate does not provide an NSManagedObjectContext, or if you’d like to provide a diffrerent one, please use definitionWithEntityName:managedObjectContext:propertyNamesString: instead."}]}],"name":"Warning"}]}],"abstract":[{"type":"text","text":"Allocates and returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for."}],"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/stv\/scentitydefinition\/definitionwithentityname:propertynamesstring:"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition/definitionWithEntityName:propertyNamesString:":{"abstract":[{"text":"Allocates and returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for.","type":"text"}],"fragments":[{"kind":"text","text":"+ "},{"text":"definitionWithEntityName:propertyNamesString:","kind":"identifier"}],"url":"\/documentation\/stv\/scentitydefinition\/definitionwithentityname:propertynamesstring:","title":"definitionWithEntityName:propertyNamesString:","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/definitionWithEntityName:propertyNamesString:","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition":{"type":"topic","fragments":[{"text":"SCEntityDefinition","kind":"identifier"}],"url":"\/documentation\/stv\/scentitydefinition","title":"SCEntityDefinition","role":"symbol","kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition","abstract":[{"type":"text","text":"This class functions as a means to further extend the definition of user-defined Core Data entities."},{"type":"text","text":" "},{"type":"text","text":"Using entity definitions, classes like SCObjectCell and SCObjectSection"},{"text":" ","type":"text"},{"type":"text","text":"will be able to better generate user interface elements that truly represent the"},{"type":"text","text":" "},{"type":"text","text":"properties of their bound objects."}]}}}