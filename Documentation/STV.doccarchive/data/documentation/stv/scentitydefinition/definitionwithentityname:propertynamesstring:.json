{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition"]]},"metadata":{"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"definitionWithEntityName:propertyNamesString:"}],"navigatorTitle":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"definitionWithEntityName:propertyNamesString:"}],"role":"symbol","title":"definitionWithEntityName:propertyNamesString:","symbolKind":"method","roleHeading":"Type Method","modules":[{"name":"STV"}],"externalID":"c:objc(cs)SCEntityDefinition(cm)definitionWithEntityName:propertyNamesString:"},"abstract":[{"type":"text","text":"Allocates and returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for."}],"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/definitionWithEntityName:propertyNamesString:","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"text","text":"+ ("},{"kind":"keyword","text":"instancetype"},{"kind":"text","text":") "},{"kind":"identifier","text":"definitionWithEntityName:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"entityName"},{"kind":"text","text":" "},{"kind":"identifier","text":"propertyNamesString:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString","text":"NSString"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"propertyNamesString"},{"kind":"text","text":";"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The name of the entity for which the definition will be extended.","type":"text"}]}],"name":"entityName"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”.","type":"text"}]}],"name":"propertyNamesString"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method will also generate user friendly property titles from the names of"},{"type":"text","text":" "},{"type":"text","text":"the given properties. These titles can be modified by the user later as part of"},{"type":"text","text":" "},{"type":"text","text":"the property definition customization."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Property names string syntax options:"},{"type":"text","text":" "},{"type":"text","text":"@“property1;property2;property3;…”"},{"type":"text","text":" "},{"type":"text","text":"@“group1 header:(property1, property2,…):group1 footer;group2…”"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Note: This method attempts to automatically determine the required NSManagedObjectContext by querying the current app delegate. If your app delegate does not provide an NSManagedObjectContext, or if you’d like to provide a diffrerent one, please use definitionWithEntityName:managedObjectContext:propertyNamesString: instead.","type":"text"}]}],"style":"warning","name":"Warning"}],"kind":"content"}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/stv\/scentitydefinition\/definitionwithentityname:propertynamesstring:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition/definitionWithEntityNa