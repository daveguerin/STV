{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition"]]},"kind":"symbol","abstract":[{"type":"text","text":"Returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"- (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"initWithEntityName:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","text":"NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"entityName","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"managedObjectContext:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSManagedObjectContext","text":"NSManagedObjectContext","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"context","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"propertyNamesString:","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSString","text":"NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"propertyNamesString","kind":"internalParam"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"parameters","parameters":[{"name":"entityName","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The name of the entity for which the definition will be extended."}]}]},{"name":"context","content":[{"inlineContent":[{"type":"text","text":"The managed object context of the entity."}],"type":"paragraph"}]},{"name":"propertyNamesString","content":[{"inlineContent":[{"type":"text","text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method will also generate user friendly property titles from the names of"},{"type":"text","text":" "},{"type":"text","text":"the given properties. These titles can be modified by the user later as part of"},{"type":"text","text":" "},{"type":"text","text":"the property definition customization."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Property names string syntax options:"},{"type":"text","text":" "},{"type":"text","text":"@“property1;property2;property3;…”"},{"type":"text","text":" "},{"type":"text","text":"@“group1 header:(property1, property2,…):group1 footer;group2…”"}]}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Instance Method","title":"initWithEntityName:managedObjectContext:propertyNamesString:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithEntityName:managedObjectContext:propertyNamesString:","kind":"identifier"}],"symbolKind":"method","modules":[{"name":"STV"}],"externalID":"c:objc(cs)SCEntityDefinition(im)initWithEntityName:managedObjectContext:propertyNamesString:","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithEntityName:managedObjectContext:propertyNamesString:","kind":"identifier"}]},"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/initWithEntityName:managedObjectContext:propertyNamesString:","interfaceLanguage":"occ"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scentitydefinition\/initwithentityname:managedobjectcontext:propertynamesstring:"]}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition/initWithEntityName:managedObjectContext:propertyNamesString:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithEntityName:managedObjectContext:propertyNamesString:"}],"kind":"symbol","url":"\/documentation\/stv\/scentitydefinition\/initwithentityname:managedobjectcontext:propertynamesstring:","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition\/initWithEntityName:managedObjectContext:propertyNamesString:","title":"initWithEntityName:managedObjectContext:propertyNamesString:","abstract":[{"text":"Returns an initialized SCEntityDefinition given a Core Data entity name and a string of the property names to generate property definitions for.","type":"text"}],"type":"topic","role":"symbol"},"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition":{"type":"topic","fragments":[{"text":"SCEntityDefinition","kind":"identifier"}],"url":"\/documentation\/stv\/scentitydefinition","title":"SCEntityDefinition","role":"symbol","kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition","abstract":[{"type":"text","text":"This class functions as a means to further extend the definition of user-defined Core Data entities."},{"type":"text","text":" "},{"type":"text","text":"Using entity definitions, classes like SCObjectCell and SCObjectSection"},{"text":" ","type":"text"},{"type":"text","text":"will be able to better generate user interface elements that truly represent the"},{"type":"text","text":" "},{"type":"text","text":"properties of their bound objects."}]}}}