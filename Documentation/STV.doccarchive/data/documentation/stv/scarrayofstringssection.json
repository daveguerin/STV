hat is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of string items and automatically generate its cells from these items. The class inherits"},{"type":"text","text":" "},{"type":"text","text":"all its funtionality from its superclass: SCArrayOfItemsSection, except that its items"},{"type":"text","text":" "},{"type":"text","text":"array can only contain items of type NSString."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfStringsSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCArrayOfStringsSection","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfStringsSection","title":"SCArrayOfStringsSection","url":"\/documentation\/stv\/scarrayofstringssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of string items and automatically generate its cells from these items. The class inherits"},{"type":"text","text":" "},{"type":"text","text":"all its funtionality from its superclass: SCArrayOfItemsSection, except that its items"},{"type":"text","text":" "},{"type":"text","text":"array can only contain items of type NSString."}]},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfStringsSection/sectionWithHeaderTitle:items:":{"role":"symbol","kind":"symbol","fragments":[{"text":"+ ","kind":"text"},{"text":"sectionWithHeaderTitle:items:","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfStringsSection\/sectionWithHeaderTitle:items:","title":"sectionWithHeaderTitle:items:","url":"\/documentation\/stv\/scarrayofstringssection\/sectionwithheadertitle:items:","abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCArrayOfItemsSection"},{"type":"text","text":" given a header title and an array of NSString items."}]},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCArrayOfObjectsSection","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection","title":"SCArrayOfObjectsSection","url":"\/documentation\/stv\/scarrayofobjectssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of any kind of objects and automatically generate its cells from these objects. In addition,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" generates its detail views from the properties of the corresponding"},{"type":"text","text":" "},{"type":"text","text":"object in its items array. Objects in the items array need not all be of the same object type, but"},{"type":"text","text":" "},{"type":"text","text":"they must all decend from NSObject. If more than one type of object is present in the items"},{"type":"text","text":" "},{"type":"text","text":"array, then their respective class definitions should be added to the itemsClassDefinitions"},{"type":"text","text":" "},{"type":"text","text":"set."}]},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCSelectionSection","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","type":"topic","title":"SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"text":"This class functions as an SCTableViewModel section that is able to provide selection functionality.","type":"text"},{"text":" ","type":"text"},{"text":"The cells in this section represent different items that the end-user can select from, and they","type":"text"},{"text":" ","type":"text"},{"text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next","type":"text"},{"text":" ","type":"text"},{"text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their","type":"text"},{"text":" ","type":"text"},{"text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfStringsSection/initWithHeaderTitle:items:":{"role":"symbol","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithHeaderTitle:items:","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfStringsSection\/initWithHeaderTitle:items:","title":"initWithHeaderTitle:items:","url":"\/documentation\/stv\/scarrayofstringssection\/initwithheadertitle:items:","abstract":[{"type":"text","text":"Returns an initialized "},{"type":"codeVoice","code":"SCArrayOfItemsSection"},{"type":"text","text":" given a header title and an array of NSString items."}]}}}