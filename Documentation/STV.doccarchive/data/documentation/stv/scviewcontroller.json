r"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"url":"\/documentation\/stv\/scselectionmodel","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","title":"SCSelectionModel","fragments":[{"text":"SCSelectionModel","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCViewController/actions":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCViewController\/actions","title":"actions","kind":"symbol","fragments":[{"kind":"identifier","text":"actions"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"The set of view controller action blocks."}],"url":"\/documentation\/stv\/scviewcontroller\/actions"},"doc://ie.dgapps.STV/documentation/STV/SCViewController/editingModeCancelButtonAction":{"fragments":[{"text":"- ","kind":"text"},{"text":"editingModeCancelButtonAction","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCViewController\/editingModeCancelButtonAction","url":"\/documentation\/stv\/scviewcontroller\/editingmodecancelbuttonaction","type":"topic","abstract":[{"type":"text","text":"Method gets called when the Cancel button is tapped while the table view is in editing mode."}],"kind":"symbol","role":"symbol","title":"editingModeCancelButtonAction"},"doc://ie.dgapps.STV/documentation/STV/SCViewController/dismissWithCancelValue:doneValue:":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCViewController\/dismissWithCancelValue:doneValue:","title":"dismissWithCancelValue:doneValue:","kind":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"dismissWithCancelValue:doneValue:"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Dismisses the view controller with the specified values for cancel and done."}],"url":"\/documentation\/stv\/scviewcontroller\/dismisswithcancelvalue:donevalue:"},"doc://ie.dgapps.STV/documentation/STV/SCViewController/editButtonAction":{"fragments":[{"text":"- ","kind":"text"},{"text":"editButtonAction","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCViewController\/editButtonAction","url":"\/documentation\/stv\/scviewcontroller\/editbuttonaction","abstract":[{"text":"Method gets called when the Edit button is tapped.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","title":"editButtonAction"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsModel":{"fragments":[{"text":"SCArrayOfObjectsModel","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsModel","url":"\/documentation\/stv\/scarrayofobjectsmodel","abstract":[{"text":"This class functions as a table view model that is able to represent an array of any kind of objects and automatically generate its cells from these objects. In addition, ","type":"text"},{"code":"SCArrayOfObjectsModel","type":"codeVoice"},{"text":" generates its detail views from the properties of the corresponding object in its items array. Objects in the items array need not all be of the same object type, but they must all decend from NSObject.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","title":"SCArrayOfObjectsModel"}}}