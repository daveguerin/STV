{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection"]]},"kind":"symbol","metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"identifier","text":"propertyGroup"}],"title":"propertyGroup","externalID":"c:objc(cs)SCObjectSection(py)propertyGroup","symbolKind":"property","navigatorTitle":[{"text":"propertyGroup","kind":"identifier"}],"modules":[{"name":"STV"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"strong"},{"kind":"text","text":") "},{"kind":"typeIdentifier","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCPropertyGroup","text":"SCPropertyGroup","preciseIdentifier":"c:objc(cs)SCPropertyGroup"},{"kind":"text","text":" * "},{"kind":"identifier","text":"propertyGroup"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"}],"sections":[],"variants":[{"paths":["\/documentation\/stv\/scobjectsection\/propertygroup-c.property"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection\/propertyGroup-c.property"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"The section’s bound object’s group of properties that are rendered into cells.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCObjectSection/propertyGroup-c.property":{"role":"symbol","kind":"symbol","fragments":[{"text":"propertyGroup","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection\/propertyGroup-c.property","type":"topic","title":"propertyGroup","url":"\/documentation\/stv\/scobjectsection\/propertygroup-c.property","abstract":[{"text":"The section’s bound object’s group of properties that are