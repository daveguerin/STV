on\/STV\/SCObjectSection\/sectionWithHeaderTitle:boundObject:boundObjectDefinition:"},"doc://ie.dgapps.STV/documentation/STV/SCObjectSection":{"kind":"symbol","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to automatically generate"},{"type":"text","text":" "},{"type":"text","text":"its cells from a given bound object’s properties. If the bound object is given without an extended"},{"type":"text","text":" "},{"type":"text","text":"class definition (SCClassDefinition), then cells will only be generated for properties of type"},{"type":"text","text":" "},{"type":"text","text":"NSString and NSNumber, and will be either of type SCTextFieldCell or SCNumericTextFieldCell,"},{"type":"text","text":" "},{"type":"text","text":"respectively. If an SCClassDefinition is provided for the bound object, a full fledged"},{"type":"text","text":" "},{"type":"text","text":"section of cells will be generated."}],"title":"SCObjectSection","url":"\/documentation\/stv\/scobjectsection","role":"symbol","fragments":[{"kind":"identifier","text":"SCObjectSection"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCDataDefinition":{"role":"symbol","type":"topic","fragments":[{"text":"SCDataDefinition","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCDataDefinition","abstract":[{"text":"This class functions as a means to further extend the definition of user-defined data structures, such as classes and Core Data entities. This enables the framework to automatically generate user interfaces that accurately resemble these structures.","type":"text"}],"kind":"symbol","url":"\/documentation\/stv\/scdatadefinition","title":"SCDataDefinition"}}}