{"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/itemsAccessoryType-c.property","interfaceLanguage":"occ"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"abstract":[{"type":"text","text":"The accessory type of the generated cells."}],"variants":[{"paths":["\/documentation\/stv\/scarrayofitemssection\/itemsaccessorytype-c.property"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"readwrite","kind":"keyword"},{"text":") ","kind":"text"},{"text":"UITableViewCellAccessoryType","preciseIdentifier":"c:@E@UITableViewCellAccessoryType","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"itemsAccessoryType","kind":"identifier"},{"text":";","kind":"text"}]}]}],"metadata":{"externalID":"c:objc(cs)SCArrayOfItemsSection(py)itemsAccessoryType","modules":[{"name":"STV"}],"title":"itemsAccessoryType","navigatorTitle":[{"kind":"identifier","text":"itemsAccessoryType"}],"symbolKind":"property","fragments":[{"text":"itemsAccessoryType","kind":"identifier"}],"role":"symbol","roleHeading":"Instance Property"},"references":{"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/itemsAccessoryType-c.property":{"title":"itemsAccessoryType","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/itemsAccessoryType-c.property","abstract":[{"type":"text","text":"The accessory type of the generated cells."}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection\/itemsaccessorytype-c.property","fragments":[{"text":"itemsAccessoryType","kind":"identifier"}],"role":"symbol","kind":"symbol"}}}