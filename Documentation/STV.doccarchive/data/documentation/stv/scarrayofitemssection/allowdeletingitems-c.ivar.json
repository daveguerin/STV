{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowDeletingItems-c.ivar","interfaceLanguage":"occ"},"metadata":{"navigatorTitle":[{"text":"allowDeletingItems","kind":"identifier"}],"externalID":"c:objc(cs)SCArrayOfItemsSection@allowDeletingItems","title":"allowDeletingItems","modules":[{"name":"STV"}],"role":"symbol","roleHeading":"Instance Variable","symbolKind":"ivar","fragments":[{"kind":"identifier","text":"allowDeletingItems"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"BOOL","kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL"},{"text":" ","kind":"text"},{"text":"allowDeletingItems","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"}],"variants":[{"paths":["\/documentation\/stv\/scarrayofitemssection\/allowdeletingitems-c.ivar"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"text":"Allows\/disables deleting new cells\/items from the items array. Default: TRUE.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/allowDeletingItems-c.ivar":{"abstract":[{"type":"text","text":"Allows\/disables deleting new cells\/items from the items array. Default: TRUE."}],"kind":"symbol","title":"allowDeletingItems","url":"\/documentation\/stv\/scarrayofitemssection\/allowdeletingitems-c.ivar","role":"symbol","fragments":[{"text":"allowDeletingItems","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowDeletingItems-c.ivar","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"}}}