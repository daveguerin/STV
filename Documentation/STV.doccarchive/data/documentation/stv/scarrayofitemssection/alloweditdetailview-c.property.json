{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"metadata":{"fragments":[{"text":"allowEditDetailView","kind":"identifier"}],"navigatorTitle":[{"text":"allowEditDetailView","kind":"identifier"}],"role":"symbol","title":"allowEditDetailView","symbolKind":"property","roleHeading":"Instance Property","modules":[{"name":"STV"}],"externalID":"c:objc(cs)SCArrayOfItemsSection(py)allowEditDetailView"},"abstract":[{"text":"Allows\/disables a detail view for editing items’ values. Default: TRUE.","type":"text"}],"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowEditDetailView-c.property","interfaceLanguage":"occ"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"readwrite","kind":"keyword"},{"text":") ","kind":"text"},{"text":"BOOL","kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL"},{"text":" ","kind":"text"},{"text":"allowEditDetailView","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Detail views are automatically generated for editing new items. You can control wether the","type":"text"},{"text":" ","type":"text"},{"text":"view appears as a modal view or gets pushed to the navigation stack using the detailViewModal","type":"text"},{"text":" ","type":"text"},{"text":"property. Modal views have the added feature of giving the end user a Cancel and Done buttons.","type":"text"},{"text":" ","type":"text"},{"text":"The Cancel button cancels all user’s actions, while the Done button commits them. Also, if the","type":"text"},{"text":" ","type":"text"},{"text":"cell’s validation is enabled, the Done button will remain disabled until all cells’ values","type":"text"},{"text":" ","type":"text"},{"text":"are valid.","type":"text"}]}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scarrayofitemssection\/alloweditdetailview-c.property"]}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/allowEditDetailView-c.property":{"fragments":[{"kind":"identifier","text":"allowEditDetailView"}],"abstract":[{"text":"Allows\/disables a detail view for editing items’ values. Default: TRUE.","type":"text"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowEditDetailView-c.property","role":"symbol","kind":"symbol","title":"allowEditDetailView","url":"\/documentation\/stv\/scarrayofitemssection\/alloweditdetailview-c.property"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"}}}