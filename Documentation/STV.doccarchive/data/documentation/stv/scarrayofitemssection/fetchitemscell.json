ly displayed by an SCArrayOfItemsSection when more section items need to be fetched. This is typically the case when the section’s dataFetchOptions property has specified a batchSize for the fetched items."}],"url":"\/documentation\/stv\/scfetchitemscell"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/fetchItemsCell":{"abstract":[{"type":"text","text":"This cell is automatically displayed when more section items need to be fetched. This is typically the case when the section’s dataFetchOptions has specified a batchSize."}],"fragments":[{"text":"fetchItemsCell","kind":"identifier"}],"title":"fetchItemsCell","url":"\/documentation\/stv\/scarrayofitemssection\/fetchitemscell","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/fetchItemsCell","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"}}}