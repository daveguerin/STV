{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"kind":"symbol","metadata":{"navigatorTitle":[{"text":"hideWhenEmpty","kind":"identifier"}],"modules":[{"name":"STV"}],"title":"hideWhenEmpty","externalID":"c:objc(cs)SCArrayOfItemsSection(py)hideWhenEmpty","role":"symbol","roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"hideWhenEmpty","kind":"identifier"}]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/hideWhenEmpty"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"readwrite","kind":"keyword"},{"text":") ","kind":"text"},{"text":"BOOL","preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier"},{"text":" ","kind":"text"},{"text":"hideWhenEmpty","kind":"identifier"},{"text":";","kind":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scarrayofitemssection\/hidewhenempty"]}],"abstract":[{"text":"Automatically hides section if it has no items. Default: FALSE.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/hideWhenEmpty":{"fragments":[{"text":"hideWhenEmpty","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"Automatically hides section if it has no items. Default: FALSE."}],"type":"topic","title":"hideWhenEmpty","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/hideWhenEmpty","url":"\/documentation\/stv\/scarrayofitemssection\/hidewhenempty","kind":"symbol"}}}