 and will add a new item to the section whenever it gets tapped by the user. This cell can be used as an alternative to addButtonItem. Default: nil."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/addButtonItem-c.property":{"fragments":[{"kind":"identifier","text":"addButtonItem"}],"type":"topic","abstract":[{"text":"Set this property to a valid UIBarButtonItem. When addButtonItem is tapped and allowAddingItems","type":"text"},{"text":" ","type":"text"},{"text":"is TRUE, a detail view is automatically generated for the user to enter the new items","type":"text"},{"text":" ","type":"text"},{"text":"properties. If the properties are commited, a new item is added to the array.","type":"text"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addButtonItem-c.property","role":"symbol","kind":"symbol","title":"addButtonItem","url":"\/documentation\/stv\/scarrayofitemssection\/addbuttonitem-c.property"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewCell":{"role":"symbol","title":"SCTableViewCell","type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewCell","abstract":[{"type":"text","text":"This class functions as a cell for SCTableViewSection. SCTableViewCell is extensively subclassed to create cells with special controls such as UITextField and UISlider."}],"fragments":[{"text":"SCTableViewCell","kind":"identifier"}],"url":"\/documentation\/stv\/sctableviewcell","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/addNewItemCell-c.property":{"fragments":[{"kind":"identifier","text":"addNewItemCell"}],"type":"topic","abstract":[{"text":"When set to a valid cell object, ","type":"text"},{"code":"addNewItemCell","type":"codeVoice"},{"text":" will be displayed as the last cell of the section, and will add a new item to the section whenever it gets tapped by the user. This cell can be used as an alternative to addButtonItem. Default: nil.","type":"text"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addNewItemCell-c.property","role":"symbol","kind":"symbol","title":"addNewItemCell","url":"\/documentation\/stv\/scarrayofitemssection\/addnewitemcell-c.property"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"}}}