{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"kind":"symbol","abstract":[{"text":"Allows\/disables automatic cell selection of newly created items. Default: TRUE.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"autoSelectNewItemCell"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Instance Variable","title":"autoSelectNewItemCell","navigatorTitle":[{"kind":"identifier","text":"autoSelectNewItemCell"}],"modules":[{"name":"STV"}],"symbolKind":"ivar","externalID":"c:objc(cs)SCArrayOfItemsSection@autoSelectNewItemCell","role":"symbol","fragments":[{"text":"autoSelectNewItemCell","kind":"identifier"}]},"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/autoSelectNewItemCell-c.ivar","interfaceLanguage":"occ"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scarrayofitemssection\/autoselectnewitemcell-c.ivar"]}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/autoSelectNewItemCell-c.ivar":{"kind":"symbol","abstract":[{"type":"text","text":"Allows\/disables automatic cell selection of newly created items. Default: TRUE."}],"title":"autoSelectNewItemCell","url":"\/documentation\/stv\/scarrayofitemssection\/autoselectnewitemcell-c.ivar","role":"symbol","fragments":[{"kind":"identifier","text":"autoSelectNewItemCell"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/autoSelectNewItemCell-c.ivar","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"}}}