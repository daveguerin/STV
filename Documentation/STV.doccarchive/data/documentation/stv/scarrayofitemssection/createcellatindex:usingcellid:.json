apps.STV\/documentation\/STV\/SCTableViewCell","abstract":[{"type":"text","text":"This class functions as a cell for SCTableViewSection. SCTableViewCell is extensively subclassed to create cells with special controls such as UITextField and UISlider."}],"fragments":[{"text":"SCTableViewCell","kind":"identifier"}],"url":"\/documentation\/stv\/sctableviewcell","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/createCellAtIndex:usingCellId:":{"role":"symbol","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"createCellAtIndex:usingCellId:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/createCellAtIndex:usingCellId:","type":"topic","url":"\/documentation\/stv\/scarrayofitemssection\/createcellatindex:usingcellid:","title":"createCellAtIndex:usingCellId:","abstract":[{"text":"Subclasses should override this method to handle the creation of section cells","type":"text"}]}}}