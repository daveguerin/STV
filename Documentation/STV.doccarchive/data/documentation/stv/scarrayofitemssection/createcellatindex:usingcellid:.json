"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scarrayofitemssection\/createcellatindex:usingcellid:"]}],"abstract":[{"type":"text","text":"Subclasses should override this method to handle the creation of section cells"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/createCellAtIndex:usingCellId:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"createCellAtIndex:usingCellId:"}],"kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection\/createcellatindex:usingcellid:","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/createCellAtIndex:usingCellId:","title":"createCellAtIndex:usingCellId:","abstract":[{"type":"text","text":"Subclasses should override this method to handle the creation of section cells"}],"type":"topic","role":"symbol"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewCell":{"title":"SCTableViewCell","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewCell","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/stv\/sctableviewcell","fragments":[{"text":"SCTableViewCell","kind":"identifier"}],"abstract":[{"text":"This class functions as a cell for SCTableViewSection. SCTableViewCell is extensively subclassed to create cells with special controls such as UITextField and UISlider.","type":"text"}]}}}