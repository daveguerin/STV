{"metadata":{"fragments":[{"text":"allowEditDetailView","kind":"identifier"}],"modules":[{"name":"STV"}],"role":"symbol","title":"allowEditDetailView","symbolKind":"ivar","roleHeading":"Instance Variable","navigatorTitle":[{"kind":"identifier","text":"allowEditDetailView"}],"externalID":"c:objc(cs)SCArrayOfItemsSection@allowEditDetailView"},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Allows\/disables a detail view for editing items’ values. Default: TRUE."}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"variants":[{"paths":["\/documentation\/stv\/scarrayofitemssection\/alloweditdetailview-c.ivar"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowEditDetailView"},{"kind":"text","text":";"}],"languages":["occ"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowEditDetailView-c.ivar"},"kind":"symbol","references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/allowEditDetailView-c.ivar":{"abstract":[{"text":"Allows\/disables a detail view for editing items’ values. Default: TRUE.","type":"text"}],"fragments":[{"text":"allowEditDetailView","kind":"identifier"}],"url":"\/documentation\/stv\/scarrayofitemssection\/alloweditdetailview-c.ivar","title":"allowEditDetailView","role":"symbol","kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowEditDetailView-c.ivar","type":"topic"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"}}}