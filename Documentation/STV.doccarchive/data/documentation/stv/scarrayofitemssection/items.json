entation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"}}}