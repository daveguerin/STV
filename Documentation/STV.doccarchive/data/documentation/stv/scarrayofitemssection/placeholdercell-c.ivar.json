role":"symbol","type":"topic","url":"\/documentation\/stv\/sctableviewcell","fragments":[{"text":"SCTableViewCell","kind":"identifier"}],"abstract":[{"text":"This class functions as a cell for SCTableViewSection. SCTableViewCell is extensively subclassed to create cells with special controls such as UITextField and UISlider.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/placeholderCell-c.ivar":{"fragments":[{"kind":"identifier","text":"placeholderCell"}],"kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection\/placeholdercell-c.ivar","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/placeholderCell-c.ivar","title":"placeholderCell","abstract":[{"text":"When set to a valid cell object, ","type":"text"},{"code":"placeholderCell","type":"codeVoice"},{"type":"text","text":" will be displayed when no items exist in the section. As soon as any items are added, this cell automatically disappears. Default: nil."}],"type":"topic","role":"symbol"}}}