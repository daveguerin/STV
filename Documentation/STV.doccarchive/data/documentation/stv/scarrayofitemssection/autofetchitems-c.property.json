{"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/autoFetchItems-c.property","interfaceLanguage":"occ"},"metadata":{"fragments":[{"kind":"identifier","text":"autoFetchItems"}],"externalID":"c:objc(cs)SCArrayOfItemsSection(py)autoFetchItems","roleHeading":"Instance Property","modules":[{"name":"STV"}],"navigatorTitle":[{"kind":"identifier","text":"autoFetchItems"}],"role":"symbol","title":"autoFetchItems","symbolKind":"property"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"readwrite"},{"kind":"text","text":") "},{"preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"autoFetchItems"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]}],"abstract":[{"type":"text","text":"Set to FALSE to disable the section from automatically fetching its items from dataStore. Default: TRUE."}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scarrayofitemssection\/autofetchitems-c.property"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"references":{"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/autoFetchItems-c.property":{"fragments":[{"text":"autoFetchItems","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection\/autofetchitems-c.property","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/autoFetchItems-c.property","title":"autoFetchItems","abstract":[{"text":"Set to FALSE to disable the section from automatically fetching its items from dataStore. Default: TRUE.","type":"text"}],"type":"topic","role":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"}}}