t","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/allowMovingItems-c.ivar":{"role":"symbol","kind":"symbol","fragments":[{"text":"allowMovingItems","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/allowMovingItems-c.ivar","title":"allowMovingItems","url":"\/documentation\/stv\/scarrayofitemssection\/allowmovingitems-c.ivar","abstract":[{"text":"Allows\/disables moving cells\/items from one row to another. Default: TRUE.","type":"text"}]}}}