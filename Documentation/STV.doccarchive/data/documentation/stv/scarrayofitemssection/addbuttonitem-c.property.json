{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"kind":"symbol","abstract":[{"text":"Set this property to a valid UIBarButtonItem. When addButtonItem is tapped and allowAddingItems","type":"text"},{"text":" ","type":"text"},{"text":"is TRUE, a detail view is automatically generated for the user to enter the new items","type":"text"},{"text":" ","type":"text"},{"text":"properties. If the properties are commited, a new item is added to the array.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":", ","kind":"text"},{"text":"strong","kind":"keyword"},{"text":") ","kind":"text"},{"text":"UIBarButtonItem","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIBarButtonItem"},{"text":" * ","kind":"text"},{"text":"addButtonItem","kind":"identifier"},{"text":";","kind":"text"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"name":"See Also","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addNewItemCell-c.property","type":"reference","isActive":true}]}]}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Property","title":"addButtonItem","navigatorTitle":[{"text":"addButtonItem","kind":"identifier"}],"modules":[{"name":"STV"}],"symbolKind":"property","role":"symbol","externalID":"c:objc(cs)SCArrayOfItemsSection(py)addButtonItem","fragments":[{"text":"addButtonItem","kind":"identifier"}]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addButtonItem-c.property"},"variants":[{"paths":["\/documentation\/stv\/scarrayofitemssection\/addbuttonitem-c.property"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/addNewItemCell-c.property":{"kind":"symbol","abstract":[{"type":"text","text":"When set to a valid cell object, "},{"code":"addNewItemCell","type":"codeVoice"},{"text":" will be displayed as the last cell of the section, and will add a new item to the section whenever it gets tapped by the user. This cell can be used as an alternative to addButtonItem. Default: nil.","type":"text"}],"title":"addNewItemCell","url":"\/documentation\/stv\/scarrayofitemssection\/addnewitemcell-c.property","role":"symbol","fragments":[{"kind":"identifier","text":"addNewItemCell"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addNewItemCell-c.property","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/addButtonItem-c.property":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addButtonItem-c.property","title":"addButtonItem","kind":"symbol","fragments":[{"kind":"identifier","text":"addButtonItem"}],"type":"topic","role":"symbol","abstract":[{"text":"Set this property to a valid UIBarButtonItem. When addButtonItem is tapped and allowAddingItems","type":"text"},{"text":" ","type":"text"},{"text":"is TRUE, a detail view is automatically generated for the user to enter the new items","type":"text"},{"text":" ","type":"text"},{"text":"properties. If the properties are commited, a new item is added to the array.","type":"text"}],"url":"\/documentation\/stv\/scarrayofitemssection\/addbuttonitem-c.property"}}}