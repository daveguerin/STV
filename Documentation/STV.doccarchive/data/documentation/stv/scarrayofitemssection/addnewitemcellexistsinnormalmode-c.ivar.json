ng, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/addNewItemCellExistsInNormalMode-c.ivar":{"role":"symbol","kind":"symbol","fragments":[{"text":"addNewItemCellExistsInNormalMode","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/addNewItemCellExistsInNormalMode-c.ivar","type":"topic","url":"\/documentation\/stv\/scarrayofitemssection\/addnewitemcellexistsinnormalmode-c.ivar","title":"addNewItemCellExistsInNormalMode","abstract":[{"type":"text","text":"When TRUE, addNewItemCell will be displayed in Normal Mode. Default: TRUE."}]},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"}}}