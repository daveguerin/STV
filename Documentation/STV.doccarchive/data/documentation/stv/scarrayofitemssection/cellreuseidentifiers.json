{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection"]]},"kind":"symbol","abstract":[{"type":"text","text":"The reuse identifiers for generated cells."}],"primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"text":"NSMutableArray","preciseIdentifier":"c:objc(cs)NSMutableArray","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"cellReuseIdentifiers","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"identifier","text":"cellReuseIdentifiers"}],"roleHeading":"Instance Variable","navigatorTitle":[{"kind":"identifier","text":"cellReuseIdentifiers"}],"symbolKind":"ivar","externalID":"c:objc(cs)SCArrayOfItemsSection@cellReuseIdentifiers","modules":[{"name":"STV"}],"role":"symbol","title":"cellReuseIdentifiers"},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/cellReuseIdentifiers"},"variants":[{"paths":["\/documentation\/stv\/scarrayofitemssection\/cellreuseidentifiers"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection/cellReuseIdentifiers":{"fragments":[{"kind":"identifier","text":"cellReuseIdentifiers"}],"kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection\/cellreuseidentifiers","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection\/cellReuseIdentifiers","title":"cellReuseIdentifiers","abstract":[{"type":"text","text":"The reuse identifiers for generated cells."}],"type":"topic","role":"symbol"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"}}}