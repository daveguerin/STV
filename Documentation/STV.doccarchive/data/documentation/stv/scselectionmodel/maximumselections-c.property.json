ragments":[{"kind":"identifier","text":"maximumSelections"}],"role":"symbol","abstract":[{"text":"The maximum number of items that can be selected. Set to zero to allow an infinite number of selections. Default: 0.","type":"text"}],"type":"topic","title":"maximumSelections","url":"\/documentation\/stv\/scselectionmodel\/maximumselections-c.property","kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/maximumSelections-c.property"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"url":"\/documentation\/stv\/scselectionmodel","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","title":"SCSelectionModel","fragments":[{"text":"SCSelectionModel","kind":"identifier"}],"kind":"symbol","type":"topic"}}}