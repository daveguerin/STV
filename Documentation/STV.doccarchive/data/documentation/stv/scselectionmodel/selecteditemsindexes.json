"type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel/selectedItemsIndexes":{"fragments":[{"text":"selectedItemsIndexes","kind":"identifier"}],"abstract":[{"type":"text","text":"This property reflects the current section’s selection(s). You can add index(es) to the set"},{"type":"text","text":" "},{"type":"text","text":"to define the section’s selection."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/selectedItemsIndexes","role":"symbol","kind":"symbol","title":"selectedItemsIndexes","url":"\/documentation\/stv\/scselectionmodel\/selecteditemsindexes"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"role":"symbol","title":"SCSelectionModel","type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"fragments":[{"kind":"identifier","text":"SCSelectionModel"}],"url":"\/documentation\/stv\/scselectionmodel","kind":"symbol"}}}