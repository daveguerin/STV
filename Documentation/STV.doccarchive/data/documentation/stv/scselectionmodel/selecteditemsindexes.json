s selection."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"url":"\/documentation\/stv\/scselectionmodel","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","title":"SCSelectionModel","fragments":[{"text":"SCSelectionModel","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel/selectedItemsIndexes":{"fragments":[{"text":"selectedItemsIndexes","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"This property reflects the current section’s selection(s). You can add index(es) to the set"},{"type":"text","text":" "},{"type":"text","text":"to define the section’s selection."}],"title":"selectedItemsIndexes","type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/selectedItemsIndexes","kind":"symbol","url":"\/documentation\/stv\/scselectionmodel\/selecteditemsindexes"}}}