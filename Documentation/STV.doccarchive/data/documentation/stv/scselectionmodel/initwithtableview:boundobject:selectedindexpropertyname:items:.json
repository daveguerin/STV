iOS","iPadOS","Mac Catalyst"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The UITableView to be bound to the model.","type":"text"}],"type":"paragraph"}],"name":"tableView"},{"content":[{"inlineContent":[{"text":"The object the model will bind to.","type":"text"}],"type":"paragraph"}],"name":"object"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property name present in the bound object that the section will bind to and","type":"text"},{"text":" ","type":"text"},{"text":"will automatically change the value of to reflect the model’s current selection. This property must","type":"text"},{"text":" ","type":"text"},{"text":"be of type NSNumber and can’t be a readonly property. The model will also initialize its selection","type":"text"},{"text":" ","type":"text"},{"text":"from the value present in this property.","type":"text"}]}],"name":"propertyName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}],"name":"sectionItems"}],"kind":"parameters"}],"abstract":[{"text":"Returns an initialized ","type":"text"},{"code":"SCSelectionModel","type":"codeVoice"},{"text":" given a table view, a bound object,","type":"text"},{"text":" ","type":"text"},{"text":"an NSNumber bound property name, and an array of selection items.","type":"text"}],"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectedindexpropertyname:items:"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel/initWithTableView:boundObject:selectedIndexPropertyName:items:":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithTableView:boundObject:selectedIndexPropertyName:items:"}],"kind":"symbol","url":"\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectedindexpropertyname:items:","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/initWithTableView:boundObject:selectedIndexPropertyName:items:","title":"initWithTableView:boundObject:selectedIndexPropertyName:items:","abstract":[{"type":"text","text":"Returns an initialized "},{"type":"codeVoice","code":"SCSelectionModel"},{"type":"text","text":" given a table view, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSNumber bound property name, and an array of selection items."}],"type":"topic","role":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"url":"\/documentation\/stv\/scselectionmodel","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","title":"SCSelectionModel","fragments":