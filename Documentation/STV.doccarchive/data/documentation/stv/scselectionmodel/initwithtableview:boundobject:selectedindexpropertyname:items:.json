cc"]}]},{"kind":"parameters","parameters":[{"name":"tableView","content":[{"inlineContent":[{"text":"The UITableView to be bound to the model.","type":"text"}],"type":"paragraph"}]},{"name":"object","content":[{"inlineContent":[{"text":"The object the model will bind to.","type":"text"}],"type":"paragraph"}]},{"name":"propertyName","content":[{"type":"paragraph","inlineContent":[{"text":"The property name present in the bound object that the section will bind to and","type":"text"},{"text":" ","type":"text"},{"text":"will automatically change the value of to reflect the model’s current selection. This property must","type":"text"},{"text":" ","type":"text"},{"text":"be of type NSNumber and can’t be a readonly property. The model will also initialize its selection","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from the value present in this property."}]}]},{"name":"sectionItems","content":[{"inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"text":" ","type":"text"},{"text":"an NSString type.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectedindexpropertyname:items:"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/initWithTableView:boundObject:selectedIndexPropertyName:items:"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Returns an initialized "},{"type":"codeVoice","code":"SCSelectionModel"},{"type":"text","text":" given a table view, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSNumber bound property name, and an array of selection items."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel/initWithTableView:boundObject:selectedIndexPropertyName:items:":{"role":"symbol","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithTableView:boundObject:selectedIndexPropertyName:items:","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/initWithTableView:boundObject:selectedIndexPropertyName:items:","url":"\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectedindexpropertyname:items:","title":"initWithTableView:boundObject:selectedIndexPropertyName:items:","abstract":[{"type":"text","text":"Returns an initialized "},{"type":"codeVoice","code":"SCSelectionModel"},{"type":"text","text":" given a table view, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSNumber bound property name, and an array of selection items."}]},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"role":"symbol","title":"SCSelectionModel","type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"fragments":[{"kind":"identifier","text":"SCSelectionModel"}],"url":"\/documentation\/stv\/scselectionmodel","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensi