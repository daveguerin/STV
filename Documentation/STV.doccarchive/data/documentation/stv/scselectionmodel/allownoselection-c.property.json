y. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"fragments":[{"kind":"identifier","text":"SCSelectionModel"}],"url":"\/documentation\/stv\/scselectionmodel","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel/allowNoSelection-c.property":{"role":"symbol","kind":"symbol","fragments":[{"text":"allowNoSelection","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/allowNoSelection-c.property","type":"topic","title":"allowNoSelection","url":"\/documentation\/stv\/scselectionmodel\/allownoselection-c.property","abstract":[{"text":"If TRUE, the section allows no selection at all. Default: FALSE.","type":"text"}]}}}