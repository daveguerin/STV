ct":[{"type":"text","text":"The model’s bound value."}]},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"role":"symbol","title":"SCSelectionModel","type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"fragments":[{"kind":"identifier","text":"SCSelectionModel"}],"url":"\/documentation\/stv\/scselectionmodel","kind":"symbol"}}}