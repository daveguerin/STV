ionItems","kind":"internalParam"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The UITableView to be bound to the model."}]}],"name":"tableView"},{"name":"object","content":[{"inlineContent":[{"type":"text","text":"The object the model will bind to."}],"type":"paragraph"}]},{"name":"propertyName","content":[{"inlineContent":[{"text":"The property name present in the bound object that the model will bind to and","type":"text"},{"type":"text","text":" "},{"text":"will automatically change the value of to reflect the model’s current selection. This property must","type":"text"},{"text":" ","type":"text"},{"text":"be of type NSString and can’t be a readonly property. The model will also initialize its selection","type":"text"},{"text":" ","type":"text"},{"text":"from the value present in this property.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}],"name":"sectionItems"}],"kind":"parameters"}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel"]]},"variants":[{"paths":["\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectionstringpropertyname:items:"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"abstract":[{"type":"text","text":"Returns an initialized "},{"type":"codeVoice","code":"SCSelectionModel"},{"type":"text","text":" given a table view, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSString bound property name, and an array of selection items."}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"