Mac Catalyst"]}]},{"kind":"parameters","parameters":[{"name":"tableView","content":[{"inlineContent":[{"text":"The UITableView to be bound to the model.","type":"text"}],"type":"paragraph"}]},{"name":"object","content":[{"inlineContent":[{"text":"The object the model will bind to.","type":"text"}],"type":"paragraph"}]},{"name":"propertyName","content":[{"inlineContent":[{"text":"The property name present in the bound object that the model will bind to and","type":"text"},{"text":" ","type":"text"},{"text":"will automatically change the value of to reflect the model’s current selection. This property must","type":"text"},{"text":" ","type":"text"},{"text":"be of type NSString and can’t be a readonly property. The model will also initialize its selection","type":"text"},{"text":" ","type":"text"},{"text":"from the value present in this property.","type":"text"}],"type":"paragraph"}]},{"name":"sectionItems","content":[{"inlineContent":[{"text":"An array of the items that the user will choose from. All items must be of","type":"text"},{"text":" ","type":"text"},{"text":"an NSString type.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectionstringpropertyname:items:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/initWithTableView:boundObject:selectionStringPropertyName:items:"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Returns an initialized ","type":"text"},{"type":"codeVoice","code":"SCSelectionModel"},{"text":" given a table view, a bound object,","type":"text"},{"text":" ","type":"text"},{"text":"an NSString bound property name, and an array of selection items.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel":{"role":"symbol","title":"SCSelectionModel","type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel","abstract":[{"type":"text","text":"This class functions as a model that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this model represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"fragments":[{"kind":"identifier","text":"SCSelectionModel"}],"url":"\/documentation\/stv\/scselectionmodel","kind":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionModel/initWithTableView:boundObject:selectionStringPropertyName:items:":{"role":"symbol","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithTableView:boundObject:selectionStringPropertyName:items:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionModel\/initWithTableView:boundObject:selectionStringPropertyName:items:","type":"topic","url":"\/documentation\/stv\/scselectionmodel\/initwithtableview:boundobject:selectionstringpropertyname:items:","title":"initWithTableView:boundObject:selectionStringPropertyName:items:","abstract":[{"text":"Returns an initialized ","type":"text"},{"type":"codeVoice","code":"SCSelectionModel"},{"text":" given a table view, a bound object,","type":"text"},{"text":" ","typ