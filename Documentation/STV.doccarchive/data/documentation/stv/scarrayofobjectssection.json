TV/documentation/STV/SCArrayOfItemsSection":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","type":"topic","kind":"symbol","url":"\/documentation\/stv\/scarrayofitemssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"type":"text","text":"automatically generated for this purpose. To enable adding cells, the class’ user should"},{"type":"text","text":" "},{"type":"text","text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then"},{"type":"text","text":" "},{"type":"text","text":"will automatically add new items when the button is tapped."}],"role":"symbol","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection":{"kind":"symbol","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of any kind of objects and automatically generate its cells from these objects. In addition,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" generates its detail views from the properties of the corresponding"},{"type":"text","text":" "},{"type":"text","text":"object in its items array. Objects in the items array need not all be of the same object type, but"},{"type":"text","text":" "},{"type":"text","text":"they must all decend from NSObject. If more than one type of object is present in the items"},{"type":"text","text":" "},{"type":"text","text":"array, then their respective class definitions should be added to the itemsClassDefinitions"},{"type":"text","text":" "},{"type":"text","text":"set."}],"title":"SCArrayOfObjectsSection","url":"\/documentation\/stv\/scarrayofobjectssection","role":"symbol","fragments":[{"kind":"identifier","text":"SCArrayOfObjectsSection"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection/sectionWithHeaderTitle:entityDefinition:filterPredicate:":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection\/sectionWithHeaderTitle:entityDefinition:filterPredicate:","title":"sectionWithHeaderTitle:entityDefinition:filterPredicate:","kind":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"sectionWithHeaderTitle:entityDefinition:filterPredicate:"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" given a header title, an entity definition, and an NSPredicate."}],"url":"\/documentation\/stv\/scarrayofobjectssection\/sectionwithheadertitle:entitydefinition:filterpredicate:"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection/sectionWithHeaderTitle:entityDefinition:":{"abstract":[{"text":"Allocates and returns an initialized ","type":"text"},{"code":"SCArrayOfObjectsSection","type":"codeVoice"},{"text":" given a header title and","type":"text"},{"text":" ","type":"text"},{"text":"an entity definition.","type":"text"}],"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"sectionWithHeaderTitle:entityDefinition:"}],"title":"sectionWithHeaderTitle:entityDefinition:","url":"\/documentation\/stv\/scarrayofobjectssection\/sectionwithheader