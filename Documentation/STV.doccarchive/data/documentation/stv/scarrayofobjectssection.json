ntation\/STV\/SCArrayOfObjectsSection\/sectionWithHeaderTitle:entityDefinition:filterPredicate:","role":"symbol","kind":"symbol","title":"sectionWithHeaderTitle:entityDefinition:filterPredicate:","url":"\/documentation\/stv\/scarrayofobjectssection\/sectionwithheadertitle:entitydefinition:filterpredicate:"},"doc://ie.dgapps.STV/documentation/STV/SCObjectSection":{"fragments":[{"text":"SCObjectSection","kind":"identifier"}],"abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to automatically generate"},{"type":"text","text":" "},{"text":"its cells from a given bound object’s properties. If the bound object is given without an extended","type":"text"},{"text":" ","type":"text"},{"text":"class definition (SCClassDefinition), then cells will only be generated for properties of type","type":"text"},{"text":" ","type":"text"},{"text":"NSString and NSNumber, and will be either of type SCTextFieldCell or SCNumericTextFieldCell,","type":"text"},{"text":" ","type":"text"},{"text":"respectively. If an SCClassDefinition is provided for the bound object, a full fledged","type":"text"},{"type":"text","text":" "},{"type":"text","text":"section of cells will be generated."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection","role":"symbol","kind":"symbol","title":"SCObjectSection","url":"\/documentation\/stv\/scobjectsection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfItemsSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfItemsSection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"text":" ","type":"text"},{"type":"text","text":"of any kind of items and automatically generate its cells from these items. The section"},{"type":"text","text":" "},{"type":"text","text":"is also able to handle all end-user interaction with the generated cells, including adding,"},{"type":"text","text":" "},{"type":"text","text":"editing, deleting, and moving the cells. When cells are added or edited, detail views are"},{"type":"text","text":" "},{"text":"automatically generated for this purpose. To enable adding cells, the class’ user should","type":"text"},{"text":" ","type":"text"},{"text":"set the addButtonItem property of the section to a valid UIBarButtonItem, the section then","type":"text"},{"text":" ","type":"text"},{"text":"will automatically add new items when the button is tapped.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scarrayofitemssection","fragments":[{"text":"SCArrayOfItemsSection","kind":"identifier"}],"role":"symbol","title":"SCArrayOfItemsSection"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection/sectionWithHeaderTitle:items:itemsDefinition:":{"fragments":[{"text":"+ ","kind":"text"},{"text":"sectionWithHeaderTitle:items:itemsDefinition:","kind":"identifier"}],"abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"code":"SCArrayOfObjectsSection","type":"codeVoice"},{"type":"text","text":" given a header title and an array of objects."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection\/sectionWithHeaderTitle:items:itemsDefinition:","role":"symbol","kind":"symbol","title":"sectionWithHeaderTitle:items:itemsDefinition:","url":"\/documentation\/stv\/scarrayofobjectssection\/sectionwithheadertitle:items:itemsdefinition:"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection/sectionWithHeaderTitle:entityDefinition:":{"fragments":[{"text":"+ ","kind":"text"},{"text":"sectionWithHeaderTitle:entityDefinition:","kind":"identifier"}],"abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"code":"SCArrayOfObjectsSection","type":"codeVoice"},{"type":"text","text":" given a header title and"},{"type":"text","text":" "},{"type":"text","text":"an entity definition."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV