 "},{"type":"text","text":"array, then their respective class definitions should be added to the itemsClassDefinitions"},{"type":"text","text":" "},{"type":"text","text":"set."}]},"doc://ie.dgapps.STV/documentation/STV/SCObjectSelectionSection":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSelectionSection","abstract":[{"text":"This class functions as a section that provides the end-user with an automatically generated","type":"text"},{"text":" ","type":"text"},{"text":"list objects to choose from.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scobjectselectionsection","fragments":[{"text":"SCObjectSelectionSection","kind":"identifier"}],"role":"symbol","title":"SCObjectSelectionSection"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCSelectionSection","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","type":"topic","title":"SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"text":"This class functions as an SCTableViewModel section that is able to provide selection functionality.","type":"text"},{"text":" ","type":"text"},{"text":"The cells in this section represent different items that the end-user can select from, and they","type":"text"},{"text":" ","type":"text"},{"text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next","type":"text"},{"text":" ","type":"text"},{"text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their","type":"text"},{"text":" ","type":"text"},{"text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection":{"role":"symbol","fragments":[{"text":"SCTableViewSection","kind":"identifier"}],"url":"\/documentation\/stv\/sctableviewsection","ide