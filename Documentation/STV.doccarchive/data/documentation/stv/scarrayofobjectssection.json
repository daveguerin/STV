entifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfStringsSection","title":"SCArrayOfStringsSection","url":"\/documentation\/stv\/scarrayofstringssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of string items and automatically generate its cells from these items. The class inherits"},{"type":"text","text":" "},{"type":"text","text":"all its funtionality from its superclass: SCArrayOfItemsSection, except that its items"},{"type":"text","text":" "},{"type":"text","text":"array can only contain items of type NSString."}]}}}