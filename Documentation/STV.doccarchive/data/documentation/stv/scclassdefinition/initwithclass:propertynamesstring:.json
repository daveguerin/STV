{"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCClassDefinition\/initWithClass:propertyNamesString:","interfaceLanguage":"occ"},"metadata":{"symbolKind":"method","title":"initWithClass:propertyNamesString:","fragments":[{"text":"- ","kind":"text"},{"text":"initWithClass:propertyNamesString:","kind":"identifier"}],"externalID":"c:objc(cs)SCClassDefinition(im)initWithClass:propertyNamesString:","role":"symbol","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"initWithClass:propertyNamesString:","kind":"identifier"}],"modules":[{"name":"STV"}],"roleHeading":"Instance Method"},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"- (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"initWithClass:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Class","preciseIdentifier":"c:@T@Class","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"_cls","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"propertyNamesString:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSString","preciseIdentifier":"c:objc(cs)NSString","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"propertyNamesString","kind":"internalParam"},{"text":";","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"_cls","content":[{"inlineContent":[{"type":"text","text":"A class for which the definition will be extended."}],"type":"paragraph"}]},{"name":"propertyNamesString","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A string with the property names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method will also generate user friendly property titles from the names of"},{"type":"text","text":" "},{"type":"text","text":"the given properties. These titles can be modified by the user later as part of"},{"type":"text","text":" "},{"type":"text","text":"the property definition customization."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Property names string syntax options:"},{"type":"text","text":" "},{"type":"text","text":"@“property1;property2;property3;…”"},{"type":"text","text":" "},{"type":"text","text":"@“group1 header:(property1, property2,…):group1 footer;group2…”"}]}],"kind":"content"}],"abstract":[{"text":"Returns an initialized SCClassDefinition given a class and a string containing the property names.","type":"text"}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scclassdefinition\/initwithclass:propertynamesstring:"]}],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCClassDefinition"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCClassDefinition":{"fragments":[{"text":"SCClassDefinition","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCClassDefinition","url":"\/documentation\/stv\/scclassdefinition","type":"topic","abstract":[{"type":"text","text":"This class functions as a means to further extend the definition of user-defined classes."},{"type":"text","text":" "},{"type":"text","text":"Using class definitions, classes like SCObjectCell and SCObjectSection"},{"type":"text","text":" "},{"type":"text","text":"will be able to better generate user interface elements that truly represent the"},{"type":"text","text":" "},{"type":"text","text":"properties of their bound objects. For more information, please refer to SCDataDefinition."}],"kind":"symbol","role":"symbol","title":"SCClassDefinition"},"doc://ie.dgapps.STV/documentation/STV/SCClassDefinition/initWithClass:propertyNamesString:":{"abstract":[{"type":"text","text":"Returns an initialized SCClassDefinition given a class and a string containing the property names."}],"kind":"symbol","title":"initWithClass:propertyNamesString:","url":"\/documentation\/stv\/scclassdefinition\/initwithclass:propertynamesstring:","role":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithClass:propertyNamesString:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCClassDefinition\/initWithClass:propertyNamesString:","type":"topic"}}}