{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionCell"]]},"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionCell\/selectedItemsIndexes-c.ivar","interfaceLanguage":"occ"},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"selectedItemsIndexes"}],"externalID":"c:objc(cs)SCSelectionCell@selectedItemsIndexes","title":"selectedItemsIndexes","modules":[{"name":"STV"}],"role":"symbol","roleHeading":"Instance Variable","symbolKind":"ivar","fragments":[{"kind":"identifier","text":"selectedItemsIndexes"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"preciseIdentifier":"c:objc(cs)NSMutableSet","text":"NSMutableSet","kind":"typeIdentifier"},{"text":" * ","kind":"text"},{"text":"selectedItemsIndexes","kind":"identifier"},{"text":";","kind":"text"}]}]}],"variants":[{"paths":["\/documentation\/stv\/scselectioncell\/selecteditemsindexes-c.ivar"],"traits":[{"interfaceLanguage":"occ"}]}],"abstract":[{"type":"text","text":"This property reflects the current cell’s selection(s). You can add index(es) to the set to define the cell’s selection."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionCell/selectedItemsIndexes-c.ivar":{"abstract":[{"type":"text","text":"This property reflects the current cell’s selection(s). You can add index(es) to the set to define the cell’s selection."}],"kind":"symbol","title":"selectedItemsIndexes","url":"\/documentation\/stv\/scselectioncell\/selecteditemsindexes-c.ivar","role":"symbol","fragments":[{"text":"selectedItemsIndexes","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionCell\/selectedItemsIndexes-c.ivar","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionCell":{"fragments":[{"text":"SCSelectionCell","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/stv\/scselectioncell","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionCell","title":"SCSelectionCell","abstract":[{"type":"text","text":"This class functions as a cell that provides the end-user with an automatically generated detail view of options to choose from, much like the Ringtone selection cell in the iPhone’s sound settings. The selection items are provided in the form of an array of NSStrings, called the items array. "},{"code":"SCSelectionCell","type":"codeVoice"},{"type":"text","text":" can be configured to allow multiple selection and to allow no selection at all. the bound property of this cell must be of type NSNumber, NSString, or NSMutableSet. If allowMultipleSelection is TRUE, then only NSString and NSMutableSet property types are allowed."}],"type":"topic","role":"symbol"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"}}}