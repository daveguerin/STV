rrayOfObjectsSection":{"kind":"symbol","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of any kind of objects and automatically generate its cells from these objects. In addition,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" generates its detail views from the properties of the corresponding"},{"type":"text","text":" "},{"type":"text","text":"object in its items array. Objects in the items array need not all be of the same object type, but"},{"type":"text","text":" "},{"type":"text","text":"they must all decend from NSObject. If more than one type of object is present in the items"},{"type":"text","text":" "},{"type":"text","text":"array, then their respective class definitions should be added to the itemsClassDefinitions"},{"type":"text","text":" "},{"type":"text","text":"set."}],"title":"SCArrayOfObjectsSection","url":"\/documentation\/stv\/scarrayofobjectssection","role":"symbol","fragments":[{"kind":"identifier","text":"SCArrayOfObjectsSection"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCArrayOfObjectsSection/sectionWithHeaderTitle:items:itemsDefinition:":{"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"sectionWithHeaderTitle:items:itemsDefinition:"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection\/sectionWithHeaderTitle:items:itemsDefinition:","url":"\/documentation\/stv\/scarrayofobjectssection\/sectionwithheadertitle:items:itemsdefinition:","abstract":[{"text":"Allocates and returns an initialized ","type":"text"},{"code":"SCArrayOfObjectsSection","type":"codeVoice"},{"text":" given a header title and an array of objects.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","title":"sectionWithHeaderTitle:items:it