neContent":[{"text":"This method creates a section with all the objects that","type":"text"},{"text":" ","type":"text"},{"text":"exist in classDefinition’s entity’s managedObjectContext. To create a section with only a subset","type":"text"},{"text":" ","type":"text"},{"text":"of these objects, consider using the other section initializers.","type":"text"}],"type":"paragraph"}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scarrayofobjectssection\/sectionwithheadertitle:entitydefinition:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection\/sectionWithHeaderTitle:entityDefinition:"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" given a header title and"},{"type":"text","text":" "},{"type":"text","text":"an entity definition."}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCEntityDefinition":{"fragments":[{"text":"SCEntityDefinition","kind":"identifier"}],"abstract":[{"type":"text","text":"This class functions as a means to further extend the definition of user-defined Core Data entities."},{"type":"text","text":" "},{"type":"text","text":"Using entity definitions, classes like SCObjectCell and SCObjectSection"},{"type":"text","text":" "},{"type":"text","text":"will be able to better generate user interface elements that truly represent the"},{"type":"text","text":" "},{"type":"text","text":"properties of their bound objects."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCEntityDefinition","role":"symbol","kind":"symbol","title":"SCEntityDefinition","url":"\/documentation\/stv\/scentitydefinition"},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text"