{"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCUserDefaultsDefinition"]]},"kind":"symbol","metadata":{"roleHeading":"Type Method","fragments":[{"text":"+ ","kind":"text"},{"text":"definitionWithUserDefaultsKeyNamesString:","kind":"identifier"}],"title":"definitionWithUserDefaultsKeyNamesString:","externalID":"c:objc(cs)SCUserDefaultsDefinition(cm)definitionWithUserDefaultsKeyNamesString:","symbolKind":"method","navigatorTitle":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"definitionWithUserDefaultsKeyNamesString:"}],"modules":[{"name":"STV"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"+ (","kind":"text"},{"text":"instancetype","kind":"keyword"},{"text":") ","kind":"text"},{"text":"definitionWithUserDefaultsKeyNamesString:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"NSString","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSString"},{"text":" *) ","kind":"text"},{"text":"keyNamesString","kind":"internalParam"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}]},{"parameters":[{"name":"keyNamesString","content":[{"inlineContent":[{"text":"A string with the key names separated by semi-colons. Example string: @“firstName;lastName”. Property groups can also be defined in the string using the following format: @“Personal Details:(firstName, lastName); Address:(street, state, country)”. The group title can also be ommitted to create a group with no title. For example: @”:(firstName, lastName)”.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"By default, all property definitions generated for the given keyNames will have a type of SCPropertyTypeTextField. This can be fully customized after initialization.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Key names string syntax options:","type":"text"},{"text":" ","type":"text"},{"text":"@“key1;key2;key3;…”","type":"text"},{"text":" ","type":"text"},{"text":"@“group1 header:(key1, key2,…):group1 footer;group2…”","type":"text"}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scuserdefaultsdefinition\/definitionwithuserdefaultskeynamesstring:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCUserDefaultsDefinition\/definitionWithUserDefaultsKeyNamesString:"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCUserDefaultsDefinition"},{"type":"text","text":" given the key names string of the user defaults."}],"references":{"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCUserDefaultsDefinition/definitionWithUserDefaultsKeyNamesString:":{"role":"symbol","kind":"symbol","fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"definitionWithUserDefaultsKeyNamesString:"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCUserDefaultsDefinition\/definitionWithUserDefaultsKeyNamesString:","title":"definitionWithUserDefaultsKeyNamesString:","url":"\/documentation\/stv\/scuserdefaultsdefinition\/definitionwithuserdefaultskeynamesstring:","abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCUserDefaultsDefinition"},{"type":"text","text":" given the key names string of the user defaults."}]},"doc://ie.dgapps.STV/documentation/STV/SCUserDefaultsDefinition":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCUserDefaultsDefinition","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCUserDefaultsDefinition","type":"topic","url":"\/documentation\/stv\/scuserdefaultsdefinition","title":"SCUserDefaultsDefinition","abstract":[{"text":"This class functions as a means to define NSUserDefaults fields that the framework can automatically generate a user interface for. As with all other types of binding, once the UI is generated, the framework will also be responsible for automatically reading and writing the values to NSUserDefaults.","type":"text"}]}}}