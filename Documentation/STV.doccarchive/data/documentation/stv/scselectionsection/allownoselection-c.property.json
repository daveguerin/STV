on","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this section represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"type":"topic","kind":"symbol","role":"symbol","title":"SCSelectionSection"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/allowNoSelection-c.property":{"fragments":[{"text":"allowNoSelection","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/allowNoSelection-c.property","url":"\/documentation\/stv\/scselectionsection\/allownoselection-c.property","role":"symbol","abstract":[{"type":"text","text":"If TRUE, the section allows no selection at all. Default: FALSE."}],"title":"allowNoSelection"}}}