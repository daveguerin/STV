],"languages":["occ"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A header title for the section."}]}],"name":"sectionHeaderTitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The object the section will bind to."}]}],"name":"object"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"type":"text","text":" "},{"type":"text","text":"will automatically change the value of to reflect the section’s current selection. This property must"},{"type":"text","text":" "},{"type":"text","text":"be of type NSNumber and can’t be a readonly property. The section will also initialize its selection"},{"type":"text","text":" "},{"type":"text","text":"from the value present in this property."}]}],"name":"propertyName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}],"name":"sectionItems"}],"kind":"parameters"}],"sections":[],"variants":[{"paths":["\/documentation\/stv\/scselectionsection\/initwithheadertitle:boundobject:selectedindexpropertyname:items:"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/initWithHeaderTitle:boundObject:selectedIndexPropertyName:items:","interfaceLanguage":"occ"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Returns an initialized ","type":"text"},{"type":"codeVoice","code":"SCSelectionSection"},{"text":" given a header title, a bound object,","type":"text"},{"text":" ","type":"text"},{"text":"an NSNumber bound property name, and an array of selection items.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/initWithHeaderTitle:boundObject:selectedIndexPropertyName:items:":