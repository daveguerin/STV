"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this section represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"type":"topic","kind":"symbol","role":"symbol","title":"SCSelectionSection"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/initWithHeaderTitle:boundObject:selectedIndexPropertyName:items:":{"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/initWithHeaderTitle:boundObject:selectedIndexPropertyName:items:","title":"initWithHeaderTitle:boundObject:selectedIndexPropertyName:items:","kind":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithHeaderTitle:boundObject:selectedIndexPropertyName:items:"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Returns an initialized "},{"type":"codeVoice","code":"SCSelectionSection"},{"type":"text","text":" given a header title, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSNumber bound