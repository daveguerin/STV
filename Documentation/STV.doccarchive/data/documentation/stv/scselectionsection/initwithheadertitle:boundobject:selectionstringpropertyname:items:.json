s"},{"kind":"text","text":";"}]}]},{"kind":"parameters","parameters":[{"name":"sectionHeaderTitle","content":[{"inlineContent":[{"type":"text","text":"A header title for the section."}],"type":"paragraph"}]},{"name":"object","content":[{"inlineContent":[{"type":"text","text":"The object the section will bind to."}],"type":"paragraph"}]},{"name":"propertyName","content":[{"inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"type":"text","text":" "},{"type":"text","text":"will automatically change the value of to reflect the section’s current selection. This property must"},{"type":"text","text":" "},{"type":"text","text":"be of type NSString and can’t be a readonly property. The section will also initialize its selection"},{"type":"text","text":" "},{"type":"text","text":"from the value present in this property."}],"type":"paragraph"}]},{"name":"sectionItems","content":[{"inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}],"type":"paragraph"}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scselectionsection\/initwithheadertitle:boundobject:selectionstringpropertyname:items:"]}],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/initWithHeaderTitle:boundObject:selectionStringPropertyName:items:"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Returns an initialized ","type":"text"},{"code":"SCSelectionSection","type":"codeVoice"},{"text":" given a header title, a bound object,","type":"text"},{"text":" ","type":"text"},{"text":"an NSString bound property name, and an array of selection items.","type":"text"}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/initWithHeaderTitle:boundObject:selectionStringPrope