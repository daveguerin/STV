":"The object the section will bind to."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"text":" ","type":"text"},{"text":"will automatically change the value of to reflect the section’s current selection. This property must","type":"text"},{"text":" ","type":"text"},{"text":"be of type NSString and can’t be a readonly property. The section will also initialize its selection","type":"text"},{"text":" ","type":"text"},{"text":"from the value present in this property.","type":"text"}]}],"name":"propertyName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}],"name":"sectionItems"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Instance Method","title":"initWithHeaderTitle:boundObject:selectionStringPropertyName:items:","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithHeaderTitle:boundObject:selectionStringPropertyName:items:"}],"modules":[{"name":"STV"}],"symbolKind":"method","role":"symbol","externalID":"c:objc(cs)SCSelectionSection(im)initWithHeaderTitle:boundObject:selectionStringPropertyName:items:","fragments":[{"text":"- ","kind":"text"},{"text":"initWithHeaderTitle:boundObject:selectionStringPropertyName:items:","kind":"identifier"}]},"identifier":{"url":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/initWithHeaderTitle:boundObject:selectionStringPropertyName:items:","interfaceLanguage":"occ"},"variants":[{"paths":["\/documentation\/stv\/scselectionsection\/initwithheadertitle:boundobject:selectionstringpropertyname:items:"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/initWithHeaderTitle:boundObject:selectionStringPrope