ypeIdentifier","preciseIdentifier":"c:objc(cs)NSArray","text":"NSArray"},{"kind":"text","text":" *) "},{"kind":"internalParam","text":"sectionItems"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowMultipleSelection:"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@BOOL","text":"BOOL"},{"kind":"text","text":") "},{"kind":"internalParam","text":"multipleSelection"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"parameters":[{"name":"sectionHeaderTitle","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A header title for the section."}]}]},{"name":"object","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The object the section will bind to."}]}]},{"name":"propertyName","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"type":"text","text":" "},{"type":"text","text":"will automatically change the value of to reflect the section’s current selection(s). This property must"},{"type":"text","text":" "},{"type":"text","text":"be of type NSMutableSet. The section will also initialize its selection(s) from the value present"},{"type":"text","text":" "},{"type":"text","text":"in this property."}]}]},{"name":"sectionItems","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}]},{"name":"multipleSelection","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Determines if multiple selection is allowed."}]}]}],"kind":"parameters"}],"metadata":{"modules":[{"name":"STV"}],"externalID":"c:objc(cs)SCSelectionSection(cm)sectionWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","roleHeading":"Type Method","navig