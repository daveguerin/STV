{"kind":"internalParam","text":"sectionItems"},{"kind":"text","text":";"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A header title for the section.","type":"text"}]}],"name":"sectionHeaderTitle"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The object the section will bind to.","type":"text"}]}],"name":"object"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"type":"text","text":" "},{"type":"text","text":"will automatically change the value of to reflect the section’s current selection. This property must"},{"type":"text","text":" "},{"type":"text","text":"be of type NSString and can’t be a readonly property. The section will also initialize its selection"},{"type":"text","text":" "},{"type":"text","text":"from the value present in this property."}]}],"name":"propertyName"},{"content":[{"inlineContent":[{"text":"An array of the items that the user will choose from. All items must be of","type":"text"},{"text":" ","type":"text"},{"text":"an NSString type.","type":"text"}],"type":"paragraph"}],"name":"sectionItems"}]}],"abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCSelectionSection"},{"type":"text","text":" given a header title, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSString bound property name, and an array of selection items."}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/stv\/scselectionsection\/sectionwithheadertitle:boundobject:selectionstringpropertyname:items:"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/ie.dgapps.STV\/documentation\/STV","doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection"]]},"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/sectionWithHeaderTitle:boundObject:selectionStringPropertyName:items:":{"fragments":[{"kind":"text","text":"+ "},{"kind":"identifier","text":"sectionWithHeaderTitle:boundObject:selectionStringPropertyName:items:"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/sectionWithHeaderTitle:boundObject:selectionStringPropertyName:items:","kind":"symbol","url":"\/documentation\/stv\/scselectionsection\/sectionwithheadertitle:boundobject:selectionstringpropertyname:items:","role":"symbol","abstract":[{"type":"text","text":"Allocates and returns an initialized "},{"type":"codeVoice","code":"SCSelectionSection"},{"type":"text","text":" given a header title, a bound object,"},{"type":"text","text":" "},{"type":"text","text":"an NSString bound property name, and an array of selection items."}],"title":"sectionWithHeaderTitle:boundObject:selectionStringPropertyName:items:"},"doc://ie.dgapps.STV/documentation/STV":{"abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"title":"STV","url":"\/documentation\/stv","role":"collection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","kind":"symbol","type":"topic"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"fragments":[{"kind":"identifier","text":"SCSelectionSection"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this section represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"type":"topic","kind":"symbol","role":"symbol","title":"SCSelectionSection"}}}