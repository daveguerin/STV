"},{"code":"NSNumber","type":"codeVoice"},{"type":"text","text":" object."}]},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"fragments":[{"kind":"identifier","text":"SCSelectionSection"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to provide selection functionality."},{"type":"text","text":" "},{"type":"text","text":"The cells in this section represent different items that the end-user can select from, and they"},{"type":"text","text":" "},{"type":"text","text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next"},{"type":"text","text":" "},{"type":"text","text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"type":"topic","kind":"symbol","role":"symbol","title":"SCSelectionSection"}}}