pe":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCSelectionSection","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","type":"topic","title":"SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"text":"This class functions as an SCTableViewModel section that is able to provide selection functionality.","type":"text"},{"text":" ","type":"text"},{"text":"The cells in this section represent different items that the end-user can select from, and they","type":"text"},{"text":" ","type":"text"},{"text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next","type":"text"},{"text":" ","type":"text"},{"text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their","type":"text"},{"text":" ","type":"text"},{"text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/sectionWithHeaderTitle:boundObject:selectedIndexPropertyName:items:":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/sectionWithHeaderTitle:boundObject:selectedIndexPropertyName:items:","abstract":[{"text":"Allocates and returns an initialized ","type":"text"},{"code":"SCSelectionSection","type":"codeVoice"},{"text":" given a header title, a bound object, an NSNumber bound property name, and an array of selection items.","type":"text"}],"type":"topic","url":"\/documentation\/stv\/scselectionsection\/sectionwithheadertitle:boundobject:selectedindexpropertyname:items:","fragments":[{"text":"+ ","kind":"text"},{"text":"sectionWithHeaderTitle:boundObject:selectedIndexPropertyName:i