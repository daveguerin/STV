kind":"text","text":";"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"A header title for the section."}],"type":"paragraph"}],"name":"sectionHeaderTitle"},{"content":[{"inlineContent":[{"text":"The object the section will bind to.","type":"text"}],"type":"paragraph"}],"name":"object"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"type":"text","text":" "},{"type":"text","text":"will automatically change the value of to reflect the section’s current selection(s). This property must"},{"type":"text","text":" "},{"type":"text","text":"be of type NSMutableSet. The section will also initialize its selection(s) from the value present"},{"type":"text","text":" "},{"type":"text","text":"in this property. Every item in this set must be an NSNumber that represent the index of the selected cell(s)."}]}],"name":"propertyName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}],"name":"sectionItems"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Determines if multiple selection is allowed.","type":"text"}]}],"name":"multipleSelection"}],"kind":"parameters"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:"}],"modules":[{"name":"STV"}],"navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:"}],"role":"symbol","title":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","symbolKind":"method","externalID":"c:objc(cs)SCSelectionSection(im)ini