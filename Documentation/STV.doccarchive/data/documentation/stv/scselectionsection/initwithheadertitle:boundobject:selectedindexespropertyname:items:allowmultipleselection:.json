dentifier"},{"text":"(","kind":"text"},{"text":"NSArray","preciseIdentifier":"c:objc(cs)NSArray","kind":"typeIdentifier"},{"text":" *) ","kind":"text"},{"text":"sectionItems","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"allowMultipleSelection:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"BOOL","preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"multipleSelection","kind":"internalParam"},{"text":";","kind":"text"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A header title for the section."}]}],"name":"sectionHeaderTitle"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The object the section will bind to."}]}],"name":"object"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property name present in the bound object that the section will bind to and"},{"type":"text","text":" "},{"type":"text","text":"will automatically change the value of to reflect the section’s current selection(s). This property must"},{"type":"text","text":" "},{"type":"text","text":"be of type NSMutableSet. The section will also initialize its selection(s) from the value present"},{"type":"text","text":" "},{"type":"text","text":"in this property. Every item in this set must be an NSNumber that represent the index of the selected cell(s)."}]}],"name":"propertyName"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of the items that the user will choose from. All items must be of"},{"type":"text","text":" "},{"type":"text","text":"an NSString type."}]}],"name":"sectionItems"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Determines if multiple selection is allowed."}]}],"name":"multipleSelection"}]}],"metadata":{"externalID":"c:objc(cs)SCSelectionSection(im)initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","modules":[{"name":"STV"}],"title":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","navigatorTitle":[{"kind":"text","text":"- "},{"kind":"identifier","text":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:"}],"symbolKind":"method","fragments":[{"text":"- ","kind":"text"},{"text":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","kind":"identifier"}],"role":"symbol","roleHeading":"Instance Method"},"references":{"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection/initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:":{"role":"symbol","kind":"symbol","fragments":[{"text":"- ","kind":"text"},{"text":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection\/initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","type":"topic","title":"initWithHeaderTitle:boundObject:selectedIndexesPropertyName:items:allowMultipleSelection:","url":"\/documentation\/stv\/scselectionsection\/initwithheadertitle:boundobject:selectedindexespropertyname:items:allowmultipleselection:","abstract":[{"text":"Returns an initialized ","type":"text"},{"code":"SCSelectionSection","type":"codeVoice"},{"text":" given a header title, a bound object,","type":"text"},{"text":" ","type":"text"},{"text":"a bound property name, an array of selection items, and wether to allow multiple selection.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV":{"kind":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV","type":"topic","abstract":[{"type":"text","text":"Build data-driven UIKit table interfaces with Sensible TableView."}],"url":"\/documentation\/stv","role":"collection","title":"STV"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCSelectionSection","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionSection","type":"topic","title":"SCSelectionSection","url":"\/documentation\/stv\/scselectionsection","abstract":[{"text":"This class functions as an SCTableViewModel section that is able to provide selection functionality.","type":"text"},{"text":" ","type":"text"},{"text":"The cells in this section represent different items that the end-user can select from, and they","type":"text"},{"text":" ","type":"text"},{"text":"are generated from NSStrings in its items array. Once a cell is selected, a checkmark appears next","type":"text"},{"text":" ","type":"text"},{"text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their","type":"text"},{"text":" ","type":"text"},{"text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all.","type":"text"}]}}}