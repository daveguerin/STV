e either of type SCTextFieldCell or SCNumericTextFieldCell,","type":"text"},{"text":" ","type":"text"},{"text":"respectively. If an SCClassDefinition is provided for the bound object, a full fledged","type":"text"},{"type":"text","text":" "},{"type":"text","text":"section of cells will be generated."}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSection","role":"symbol","kind":"symbol","title":"SCObjectSection","url":"\/documentation\/stv\/scobjectsection"},"doc://ie.dgapps.STV/documentation/STV/SCObjectSelectionSection/selectedItemsIndexes-c.ivar":{"title":"selectedItemsIndexes","kind":"symbol","type":"topic","url":"\/documentation\/stv\/scobjectselectionsection\/selecteditemsindexes-c.ivar","role":"symbol","fragments":[{"text":"selectedItemsIndexes","kind":"identifier"}],"abstract":[{"text":"This property reflects the current section’s selection(s). You can add index(es) to the set to define the section’s selection.","type":"text"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSelectionSection\/selectedItemsIndexes-c.ivar"},"doc://ie.dgapps.STV/documentation/STV/SCTableViewSection":{"role":"symbol","fragments":[{"text":"SCTableViewSection","kind":"identifier"}],"url":"\/documentation\/stv\/sctableviewsection","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCTableViewSection","kind":"symbol","type":"topic","abstract":[{"text":"This class functions as a section for SCTableViewModel. Every ","type":"text"},{"code":"SCTableViewSection","type":"codeVoice"},{"text":" can contain","type":"text"},{"text":" ","type":"text"},{"text":"any number of SCTableViewCell(s).","type":"text"}],"title":"SCTableViewSection"},"doc://ie.dgapps.STV/documentation/STV/SCObjectSelectionSection/autoDismissViewController-c.property":{"role":"symbol","kind":"symbol","fragments":[{"text":"autoDismissViewController","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSelectionSection\/autoDismissV