bjectsSection":{"role":"symbol","kind":"symbol","fragments":[{"text":"SCArrayOfObjectsSection","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCArrayOfObjectsSection","title":"SCArrayOfObjectsSection","url":"\/documentation\/stv\/scarrayofobjectssection","abstract":[{"type":"text","text":"This class functions as an SCTableViewModel section that is able to represent an array"},{"type":"text","text":" "},{"type":"text","text":"of any kind of objects and automatically generate its cells from these objects. In addition,"},{"type":"text","text":" "},{"type":"codeVoice","code":"SCArrayOfObjectsSection"},{"type":"text","text":" generates its detail views from the properties of the corresponding"},{"type":"text","text":" "},{"type":"text","text":"object in its items array. Objects in the items array need not all be of the same object type, but"},{"type":"text","text":" "},{"type":"text","text":"they must all decend from NSObject. If more than one type of object is present in the items"},{"type":"text","text":" "},{"type":"text","text":"array, then their respective class definitions should be added to the itemsClassDefinitions"},{"type":"text","text":" "},{"type":"text","text":"set."}]}}}