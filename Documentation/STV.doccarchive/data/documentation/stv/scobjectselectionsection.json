:" ","type":"text"},{"text":"to it, similar to Apple’s Settings application where a user selects a Ringtone for their","type":"text"},{"text":" ","type":"text"},{"text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCObjectSelectionSection/maximumSelections-c.property":{"role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"maximumSelections"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSelectionSection\/maximumSelections-c.property","type":"topic","title":"maximumSelections","url":"\/documentation\/stv\/scobjectselectionsection\/maximumselections-c.property","abstract":[{"text":"The maximum number of items that can be selected. Set to zero to allow an infinite number of selections. Default: 0.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCObjectSelectionSection/selectedItemIndex":{"role":"symbol","kind":"symbol","fragments":[{"text":"selectedItemIndex","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSelectionSection\/selectedItemIndex","type":"topic","title":"selectedItemIndex","url":"\/documentation\/stv\/scobjectselectionsection\/selecteditemindex","abstract":[{"text":"This property reflects the current section’s selection. You can set this property","type":"text"},{"text":" ","type":"text"},{"text":"to define the section’s selection.","type":"text"}]},"doc://ie.dgapps.STV/documentation/STV/SCObjectSelectionSection/deselectedCellTextColor":{"role":"symbol","kind":"symbol","fragments":[{"text":"deselectedCellTextColor","kind":"identifier"}],"identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCObjectSelectionSection\/deselectedCellTextColor","type":"topic","url":"\/documentation\/stv\/scobjectselectionsection\/deselectedcelltextcolor","title":"deselectedCellTextColor","abstract":[{"type":"text","text":"The text color of the deselected cell(s)."}]},"doc://ie.