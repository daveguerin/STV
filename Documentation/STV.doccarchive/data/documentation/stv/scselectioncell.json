ation where a user selects a Ringtone for their"},{"type":"text","text":" "},{"type":"text","text":"iPhone. The section can be configured to allow multiple selection and to allow no selection at all."}],"type":"topic","kind":"symbol","role":"symbol","title":"SCSelectionSection"},"doc://ie.dgapps.STV/documentation/STV/SCSelectionCell/addNewItemCellExistsInEditingMode":{"abstract":[{"type":"text","text":"When TRUE, addNewItemCell will be displayed in Editing Mode. Default: TRUE."}],"fragments":[{"text":"addNewItemCellExistsInEditingMode","kind":"identifier"}],"url":"\/documentation\/stv\/scselectioncell\/addnewitemcellexistsineditingmode","title":"addNewItemCellExistsInEditingMode","role":"symbol","identifier":"doc:\/\/ie.dgapps.STV\/documentation\/STV\/SCSelectionCell\/addNewItemCellExistsInEditingMode","kind":"symbol","type":"topic"}}}